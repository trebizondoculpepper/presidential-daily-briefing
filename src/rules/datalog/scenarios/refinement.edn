          {:e 200 "refinement-state" "resolved" "refinement-estimated" true "refinement-question" 300}
          {:e 300 "record-trust" "trusted" "record-version" 2 "record-outcome" "resolved"}
          {:e 101 "kind" "issue" "state" "OPEN" "number" 2 "target" "https://github.com/o/r/issues/2" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "current" "impact-size" "M" "complexity-state" "current" "complexity-size" "M" "head" "not-a-pr" "label" "status:ready" "refinement" 201 "refinement" 202}
          {:e 201 "refinement-state" "resolved" "refinement-estimated" true "refinement-question" 301}
          {:e 301 "record-trust" "trusted" "record-version" 2 "record-outcome" "resolved"}
          {:e 202 "refinement-state" "open" "refinement-question" 302}
          {:e 302 "record-trust" "trusted" "record-version" 2 "record-outcome" "none"}]
  :expect {:actions [{:subject 100 :rule "D-ORDINARY" :kind "implement" :band 6}
