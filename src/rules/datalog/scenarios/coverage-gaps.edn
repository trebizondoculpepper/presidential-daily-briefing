  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "head" "not-a-pr" "impact-state" "current" "impact-size" "L" "complexity-state" "current" "complexity-size" "S" "label" ["agent:me"] "owner" "me"}]
