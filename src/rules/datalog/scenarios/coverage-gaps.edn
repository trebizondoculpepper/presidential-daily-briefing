 {:id "an-open-closing-pr-denies-pickup"
  :doc "A ready ticket that an open PR already closes is not offered for implementation (D-DENY-OPEN-PR)."
  :viewer {:role "implementer"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "head" "not-a-pr" "impact-state" "current" "impact-size" "M" "complexity-state" "current" "complexity-size" "M" "label" "status:ready"}
          {:e 101 "kind" "pr" "state" "OPEN" "number" 2 "target" "https://github.com/o/r/pull/2" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "head2" "draft" false "pr-complete" true "review-decision" "" "mergeable" "MERGEABLE" "merge-state" "CLEAN" "closes" 100 "check" 102}
