 {:id "conflicting-complexity-is-inspected-not-estimated"
  :doc "Conflicting complexity evidence asks an implementer to inspect, never to estimate over it (D-BAD-COMPLEXITY)."
  :viewer {:role "implementer"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "head" "not-a-pr" "impact-state" "current" "impact-size" "M" "complexity-state" "conflict" "complexity-size" "unknown" "label" "status:ready"}]
  :expect {:actions [{:subject 100 :rule "D-BAD-COMPLEXITY" :kind "inspect-assessment" :band 5
              :why "Complexity evidence is conflict; inspect and correct the labels or provenance."
              :facts {"impact" "M" "complexity" "unknown" "impactState" "current" "complexityState" "conflict" "head" "not-a-pr" "labelsComplete" true "nativeComplete" true "openBlockers" 0 "readiness" "status:ready"}
              :overridden [] :unlocks 0 :unknown [] :other-claims []}
            {:subject 100 :rule "D-ORDINARY" :kind "implement" :band 6
              :why "Eligible implementation: impact M (current), complexity unknown (conflict)."
              :facts {"impact" "M" "complexity" "unknown" "impactState" "current" "complexityState" "conflict" "head" "not-a-pr" "labelsComplete" true "nativeComplete" true "openBlockers" 0 "readiness" "status:ready"}
              :overridden [] :unlocks 0 :unknown [] :other-claims []}]
           :denials #{}}}

