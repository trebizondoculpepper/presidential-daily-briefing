 {:id "accepted-pr-behind-base-needs-integration"
  :doc "An accepted PR (verify passed, head approved, no findings) whose branch is behind asks to update and recheck, not merge (D-PR-INTEGRATE)."
  :viewer {:role "implementer"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "pr" "state" "OPEN" "number" 2 "target" "https://github.com/o/r/pull/2" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "head2" "draft" false "pr-complete" true "review-decision" "" "mergeable" "MERGEABLE" "merge-state" "BEHIND" "check" 101 "review" 102}
          {:e 101 "name" "verify" "outcome" "SUCCESS"}
          {:e 102 "review-state" "APPROVED" "review-commit" "head2"}]
  :expect {:actions [{:subject 100 :rule "D-PR-INTEGRATE" :kind "pr-follow-up" :band 2
              :why "Accepted at head head2 (verify passed, head reviewed, no fetched findings) but merge state is BEHIND, mergeable MERGEABLE; refresh mergeability or update the branch, then recheck before considering merge."
              :facts {"impact" "unknown" "complexity" "unknown" "impactState" "unknown" "complexityState" "unknown" "head" "head2" "labelsComplete" true "nativeComplete" true "openBlockers" 0 "mergeable" "MERGEABLE" "mergeState" "BEHIND" "verify" "SUCCESS"}
              :overridden [] :unlocks 0 :unknown [] :other-claims []}]
           :denials #{}}}

 {:id "designer-documents-an-agreed-decision"
  :doc "A designer is asked to document a ticket marked design:documentation-needed (D-DOCUMENT)."
  :viewer {:role "designer"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "head" "not-a-pr" "impact-state" "current" "impact-size" "M" "complexity-state" "current" "complexity-size" "M" "label" ["status:ready" "design:documentation-needed"]}]
  :expect {:actions [{:subject 100 :rule "D-DOCUMENT" :kind "document" :band 3
              :why "An agreed decision needs documentation before implementation."
              :facts {"impact" "M" "complexity" "M" "impactState" "current" "complexityState" "current" "head" "not-a-pr" "labelsComplete" true "nativeComplete" true "openBlockers" 0 "readiness" "status:ready" "documentationLabel" "design:documentation-needed"}
              :overridden [] :unlocks 0 :unknown [] :other-claims []}]
