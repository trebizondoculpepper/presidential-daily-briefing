;; Coverage scenarios from the #340 audit (doc/reports/rule-test-coverage-audit.md): one case per
;; decision rule or denial that no other scenario selected. Each was written from the rule's stated
;; intent, run through the real engine, and checked against that intent before being recorded.
;; Expectations are exhaustive, as in policy-cases.edn.
{:suite "coverage-gaps"
 :scenarios
 [
 {:id "pr-changes-requested-is-review-follow-up"
  :doc "A PR with requested changes and otherwise passing checks asks for review follow-up, not merge (D-PR-REVIEW)."
  :viewer {:role "implementer"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "pr" "state" "OPEN" "number" 2 "target" "https://github.com/o/r/pull/2" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "head2" "draft" false "pr-complete" true "review-decision" "" "mergeable" "MERGEABLE" "merge-state" "CLEAN" "check" 101 "thread" 102}
          {:e 101 "name" "verify" "outcome" "SUCCESS"}
          {:e 102 "resolved" false}]
  :expect {:actions [{:subject 100 :rule "D-PR-REVIEW" :kind "pr-follow-up" :band 2
              :why "PR has unresolved review findings at head head2."
              :facts {"impact" "unknown" "complexity" "unknown" "impactState" "unknown" "complexityState" "unknown" "head" "head2" "labelsComplete" true "nativeComplete" true "openBlockers" 0 "reviewDecision" "" "unresolvedThreads" "unresolved"}
              :overridden [] :unlocks 0 :unknown [] :other-claims []}]
           :denials #{}}}

