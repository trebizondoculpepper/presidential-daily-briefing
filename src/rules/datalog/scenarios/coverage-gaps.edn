  :doc "A conflicting PR asks for conflict resolution (D-PR-CONFLICT)."
  :viewer {:role "implementer"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "pr" "state" "OPEN" "number" 2 "target" "https://github.com/o/r/pull/2" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "head2" "draft" false "pr-complete" true "review-decision" "" "mergeable" "CONFLICTING" "merge-state" "DIRTY" "check" 101}
          {:e 101 "name" "verify" "outcome" "SUCCESS"}]
  :expect {:actions [{:subject 100 :rule "D-PR-CONFLICT" :kind "pr-follow-up" :band 2
              :why "PR has merge conflicts at head head2."
              :facts {"impact" "unknown" "complexity" "unknown" "impactState" "unknown" "complexityState" "unknown" "head" "head2" "labelsComplete" true "nativeComplete" true "openBlockers" 0 "mergeable" "CONFLICTING"}
              :overridden [] :unlocks 0 :unknown [] :other-claims []}]
