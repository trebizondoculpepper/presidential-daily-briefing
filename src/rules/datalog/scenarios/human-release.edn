;; Human-directed responsibility release (#1018, doc/design/human-responsibility-release.md).
;; The host asserts a release direction per issue URL ('deliverables N unassign --from AGENT')
;; with trust provenance, the released agent and the preserved open PRs. Only a trusted direction
;; is a human release. Preserved unowned PR work is adoptable existing work for an otherwise
;; eligible agent; clearing ownership does not exclude the former owner (owner correction, #1130):
;; release/removal alone creates no cooldown or fresh-direction requirement for it to claim or
;; adopt. Ordinary new-implementation admission still duplicates no open PR, and a replaced owner
;; is a conflict, never silently removed again.
{:suite "human-release"
 :scenarios
 [
 {:id "unowned-preserved-pr-work-is-adoptable-after-human-release"
  :doc "A trusted human release cleared the agent; preserved open PR work is adoptable by an otherwise eligible agent."
  :viewer {:role "implementer" :agent "me"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1 "label" "status:ready" "labels-complete" true "native-complete" true "reverse-complete" true "blocking-complete" true "open-blockers" 0 "impact-state" "current" "impact-size" "M" "complexity-state" "current" "complexity-size" "M" "head" "not-a-pr" "release" 200}
          {:e 200 "release-trust" "trusted" "release-from" "previous" "release-pr" 210}
          {:e 210 "state" "OPEN" "closes" 100}]
  :expect {:actions [{:subject 100 :rule "D-ADOPT" :kind "implement" :band 6
              :why "Preserved unowned PR work: a human-directed release cleared previous from this ticket; an open PR continues it. Adopt it and become responsible. Impact M (current), complexity M (current)."
              :facts {"impact" "M" "complexity" "M" "impactState" "current" "complexityState" "current" "head" "not-a-pr" "labelsComplete" true "nativeComplete" true "openBlockers" 0 "readiness" "status:ready" "releaseFrom" "previous"}
              :overridden [] :unlocks 0 :unknown [] :other-claims []}]
           :denials #{}}}

 {:id "former-owner-may-reclaim-unowned-preserved-work"
  :doc "Clearing ownership does not exclude the former owner: the released agent is eligible to adopt the preserved unowned PR work like any agent (owner correction, #1130)."
  :viewer {:role "implementer" :agent "previous"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1 "label" "status:ready" "labels-complete" true "native-complete" true "reverse-complete" true "blocking-complete" true "open-blockers" 0 "impact-state" "current" "impact-size" "M" "complexity-state" "current" "complexity-size" "M" "head" "not-a-pr" "release" 200}
          {:e 200 "release-trust" "trusted" "release-from" "previous" "release-pr" 210}
          {:e 210 "state" "OPEN"}]
  :expect {:actions [{:subject 100 :rule "D-ADOPT" :kind "implement" :band 6
              :why "Preserved unowned PR work: a human-directed release cleared previous from this ticket; an open PR continues it. Adopt it and become responsible. Impact M (current), complexity M (current)."
              :facts {"impact" "M" "complexity" "M" "impactState" "current" "complexityState" "current" "head" "not-a-pr" "labelsComplete" true "nativeComplete" true "openBlockers" 0 "readiness" "status:ready" "releaseFrom" "previous"}
              :overridden [] :unlocks 0 :unknown [] :other-claims []}]
           :denials #{}}}

 {:id "untrusted-direction-stays-an-ordinary-open-pr-denial"
  :doc "An unverified or unknown-trust direction is not a human release: adoption is not offered and the open-PR deny stays."
  :viewer {:role "implementer" :agent "me"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1 "label" "status:ready" "labels-complete" true "native-complete" true "reverse-complete" true "blocking-complete" true "open-blockers" 0 "impact-state" "current" "impact-size" "M" "complexity-state" "current" "complexity-size" "M" "head" "not-a-pr" "release" 200}
          {:e 200 "release-trust" "unverified" "release-from" "previous" "release-pr" 210}
          {:e 210 "state" "OPEN" "closes" 100}]
  :expect {:actions []
           :denials #{[100 "D-DENY-OPEN-PR"]}}}

 {:id "already-unowned-without-pr-is-ordinary-for-elsewhere"
  :doc "A trusted release with no preserved open PR leaves an unowned ticket: ordinary pickup applies for other agents (no adoption row, no special deny)."
  :viewer {:role "implementer" :agent "me"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1 "label" "status:ready" "labels-complete" true "native-complete" true "reverse-complete" true "blocking-complete" true "open-blockers" 0 "impact-state" "current" "impact-size" "M" "complexity-state" "current" "complexity-size" "M" "head" "not-a-pr" "release" 200}
          {:e 200 "release-trust" "trusted" "release-from" "previous"}]
  :expect {:actions [{:subject 100 :rule "D-ORDINARY" :kind "implement" :band 6
              :why "Eligible implementation: impact M (current), complexity M (current)."
              :facts {"impact" "M" "complexity" "M" "impactState" "current" "complexityState" "current" "head" "not-a-pr" "labelsComplete" true "nativeComplete" true "openBlockers" 0 "readiness" "status:ready"}
              :overridden [] :unlocks 0 :unknown [] :other-claims []}]
           :denials #{}}}

 {:id "replaced-owner-is-a-conflict-never-silently-removed"
  :doc "After a release, another agent claimed the ticket: adoption is denied (already claimed), not silently reassigned again."
  :viewer {:role "implementer" :agent "me"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1 "label" "status:ready" "labels-complete" true "native-complete" true "reverse-complete" true "blocking-complete" true "open-blockers" 0 "impact-state" "current" "impact-size" "M" "complexity-state" "current" "complexity-size" "M" "head" "not-a-pr" "release" 200 "owner" "other"}
          {:e 200 "release-trust" "trusted" "release-from" "previous" "release-pr" 210}
          {:e 210 "state" "OPEN"}]
  :expect {:actions []
           :denials #{[100 "D-DENY-CLAIM"]}}}

 {:id "awaiting-review-adoption-is-not-claim-not-ready"
  :doc "Adoptable preserved work may retain status:awaiting-review; the claim needed to become responsible is not refused for missing readiness (CLAIM-NOT-READY), and no implementation deny blocks adoption."
  :viewer {:role "implementer" :agent "me"}
  :facts [{:e 1 "forward-complete" true "owned-claims-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1 "label" "status:awaiting-review" "labels-complete" true "native-complete" true "reverse-complete" true "blocking-complete" true "open-blockers" 0 "impact-state" "current" "impact-size" "M" "complexity-state" "current" "complexity-size" "M" "head" "not-a-pr" "release" 200}
          {:e 200 "release-trust" "trusted" "release-from" "previous" "release-pr" 210}
          {:e 210 "state" "OPEN"}]
  :expect {:actions [{:subject 100 :rule "D-ADOPT" :kind "implement" :band 6
              :why "Preserved unowned PR work: a human-directed release cleared previous from this ticket; an open PR continues it. Adopt it and become responsible. Impact M (current), complexity M (current)."
              :facts {"impact" "M" "complexity" "M" "impactState" "current" "complexityState" "current" "head" "not-a-pr" "labelsComplete" true "nativeComplete" true "openBlockers" 0 "releaseFrom" "previous"}
              :overridden [] :unlocks 0 :unknown [] :other-claims []}]
           :denials #{}}}

 {:id "adoption-denied-by-other-implementation-blockers"
  :doc "A preserved unowned PR ticket with an open native blocker is denied, not adopted: the implementation denies (blocker, prerequisite, platform, incomplete evidence) apply to adoptable work too."
  :viewer {:role "implementer" :agent "me"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1 "label" "status:ready" "labels-complete" true "native-complete" true "reverse-complete" true "blocking-complete" false "open-blockers" 1 "impact-state" "current" "impact-size" "M" "complexity-state" "current" "complexity-size" "M" "head" "not-a-pr" "release" 200 "blocker" 300}
          {:e 200 "release-trust" "trusted" "release-from" "previous" "release-pr" 210}
          {:e 210 "state" "OPEN"}
          {:e 300 "state" "OPEN"}]
  :expect {:actions []
           :denials #{[100 "D-DENY-BLOCKER"]}}}
 ]}
