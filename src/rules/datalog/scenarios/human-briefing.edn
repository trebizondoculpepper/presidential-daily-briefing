;; Human briefing role (doc/design/human-briefing.md, #457). Question records are nested
;; entities carrying only the host's trust verdict and routing name; the policy decides the rest.
{:suite "human-briefing"
 :scenarios
 [{:id "human-addressed-explicit-before-inferred"
  :doc "addressed attention and questions routed to the human lead; explicit questions precede unverified, unrecorded decisions and inferred sign-off; a resolved record yields nothing"
  :viewer {:role "human" :agent "owner"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 5 "target" "https://github.com/o/r/issues/5" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" ["question" "status:needs-design"] "question-record" 200}
          {:e 200 "record-trust" "trusted" "record-to" "owner"}
          {:e 101 "kind" "issue" "state" "OPEN" "number" 3 "target" "https://github.com/o/r/issues/3" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" "design:decision-needed" "question-record" 201}
          {:e 201 "record-trust" "trusted" "record-to" "designer-a"}
          {:e 102 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" "design:decision-needed"}
          {:e 103 "kind" "issue" "state" "OPEN" "number" 2 "target" "https://github.com/o/r/issues/2" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" "question" "question-record" 202}
          {:e 202 "record-trust" "unverified" "record-to" "owner"}
          {:e 104 "kind" "pr" "state" "OPEN" "number" 4 "target" "https://github.com/o/r/pull/4" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "head4" "draft" false "mergeable" "MERGEABLE" "merge-state" "CLEAN" "review-decision" "APPROVED" "pr-complete" true "check" 203 "review" 204}
          {:e 203 "name" "verify" "outcome" "SUCCESS"}
          {:e 204 "review-state" "APPROVED" "review-commit" "head4"}
          {:e 105 "kind" "issue" "state" "OPEN" "number" 6 "target" "https://github.com/o/r/issues/6" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" false "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" ["status:ready" "attention:owner"] "attention" "owner"}
          {:e 106 "kind" "issue" "state" "OPEN" "number" 7 "target" "https://github.com/o/r/issues/7" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" "status:ready" "question-record" 205}
          {:e 205 "record-trust" "trusted" "record-to" "owner"}]
  :expect {:actions [{:subject 100 :rule "D-HUMAN-ASK-YOU" :kind "answer-questions" :band 1
              :why "A trusted question record routed to you (owner) awaits answers on the ticket."
              :overridden []}
            {:subject 105 :rule "D-ATTENTION" :kind "addressed-response" :band 1
              :why "Explicitly addressed to you; respond before clearing attention."
              :overridden []}
            {:subject 101 :rule "D-HUMAN-ASK" :kind "answer-questions" :band 3
              :why "A trusted question record routed to designer-a awaits answers on the ticket."
              :overridden []}
            {:subject 103 :rule "D-HUMAN-UNVERIFIED" :kind "decide" :band 3
              :why "Labelled question; a question record exists but its author's authority is unverified. Inferred: confirm the decision needed."
              :overridden ["D-HUMAN-DECIDE"]}
            {:subject 102 :rule "D-HUMAN-DECIDE" :kind "decide" :band 3
              :why "Labelled design:decision-needed without a trusted question record. Inferred: a decision may be needed."
              :overridden []}
            {:subject 104 :rule "D-HUMAN-SIGNOFF" :kind "sign-off" :band 3
              :why "Accepted at head head4: verify passed, head reviewed, no findings. Inferred: merge sign-off candidate; nobody asked explicitly."
              :overridden []}]
           :denials #{[105 "D-DENY-NATIVE-UNKNOWN"]}}}

 {:id "human-unrouted-never-addressed"
  :doc "without a named human, a trusted record routed to anyone is explicit but not addressed, and attention labels address nobody"
  :viewer {:role "human"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 5 "target" "https://github.com/o/r/issues/5" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" ["question" "attention:owner"] "attention" "owner" "question-record" 200}
          {:e 200 "record-trust" "trusted" "record-to" "owner"}]
  :expect {:actions [{:subject 100 :rule "D-HUMAN-ASK" :kind "answer-questions" :band 3
              :why "A trusted question record routed to owner awaits answers on the ticket."
              :overridden []}]
           :denials #{}}}

 {:id "human-more-active-dependents-first-within-a-preference"
  :doc "within one preference, the decision holding up more active work ranks first, then number"
  :viewer {:role "human" :agent "owner"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" "design:decision-needed"}
          {:e 101 "kind" "issue" "state" "OPEN" "number" 2 "target" "https://github.com/o/r/issues/2" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" "design:decision-needed" "dependent" 102}
          {:e 102 "kind" "issue" "state" "OPEN" "number" 3 "target" "https://github.com/o/r/issues/3" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" ["status:ready" "agent:someone"] "owner" "someone" "blocker" 101 "open-blockers" 1}]
  :expect {:actions [{:subject 101 :rule "D-HUMAN-DECIDE" :kind "decide" :band 3 :overridden []}
            {:subject 100 :rule "D-HUMAN-DECIDE" :kind "decide" :band 3 :overridden []}]
           :denials #{[102 "D-DENY-CLAIM"] [102 "D-DENY-BLOCKER"]}}}

 {:id "human-sees-parked-questions"
  :doc "a parked ticket with a trusted question record and no matching attention label still asks the human"
  :viewer {:role "human" :agent "owner"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 5 "target" "https://github.com/o/r/issues/5" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" ["question" "status:parked"] "question-record" 200}
          {:e 200 "record-trust" "trusted" "record-to" "designer-a"}]
  :expect {:actions [{:subject 100 :rule "D-HUMAN-ASK" :kind "answer-questions" :band 3
              :why "A trusted question record routed to designer-a awaits answers on the ticket."
              :overridden []}]
           :denials #{}}}

 {:id "agent-roles-ignore-question-records"
  :doc "question record facts add nothing to the implementer queue: the question label is still a prerequisite"
  :viewer {:role "implementer" :agent "owner"}
  :facts [{:e 1 "forward-complete" true}
          {:e 100 "kind" "issue" "state" "OPEN" "number" 5 "target" "https://github.com/o/r/issues/5" "created" 1767225600000 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "unknown" "impact-size" "unknown" "complexity-state" "unknown" "complexity-size" "unknown" "head" "not-a-pr" "label" ["question" "status:ready"] "question-record" 200}
          {:e 200 "record-trust" "trusted" "record-to" "owner"}]
  :expect {:actions []
           :denials #{[100 "D-DENY-PREREQUISITE"]}}}]}
