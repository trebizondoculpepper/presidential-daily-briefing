;; Native claim action obligations (#1113, #1114, doc/design/native-action-obligations.md).
;; The native mechanism: policy/obligations.edn holds each obligation record (id, applicable
;; outcome(s), work kind(s), optional role restriction and purpose); policy/rules.edn derives
;; claim-obligation from the asserted claim-outcome/claim-work facts on entity 1 and the caller
;; role; the :claim-obligations query selects the applicable IDs in source order. These scenarios
;; assert the same typed facts the adapter transacts, covering the outcome matrix, the
;; implementer-only DELIVERABLE restriction and the #1114 early-publication duty for
;; repository-changing work (implementation and documentation), excluding observational work.
;; The viewer role is asserted by the engine ([1 "role" viewer]); an unresolved-role exclusion
;; is a native claim-role fact the adapter supplies only when the role is known.
{:suite "obligations (#1113, #1114)"
 :scenarios
 [{:id "claimed-implementer-publication"
   :doc "A successful implementation claim by an implementer leads with the early-publication duty and confers every owner duty."
   :viewer {:role "implementer"}
   :facts [{:e 1 "claim-outcome" "claimed" "claim-role" "implementer" "claim-work" "repository-changing"}
           {:e 101 "obligation" "O-CLAIM-PUBLISH-EARLY" "obligation-order" 0 "obligation-outcome" ["claimed" "noop" "partial"] "obligation-role" ["implementer" "designer"] "obligation-work" "repository-changing"}
           {:e 102 "obligation" "O-CLAIM-ACCEPTANCE" "obligation-order" 1 "obligation-outcome" ["claimed" "noop"] "obligation-work" ["repository-changing" "observational"]}
           {:e 103 "obligation" "O-CLAIM-OWNERSHIP" "obligation-order" 2 "obligation-outcome" ["claimed" "noop" "denied" "partial"] "obligation-work" ["repository-changing" "observational"]}
           {:e 104 "obligation" "O-CLAIM-BLOCKERS" "obligation-order" 3 "obligation-outcome" ["claimed" "noop"] "obligation-work" ["repository-changing" "observational"]}
           {:e 105 "obligation" "O-CLAIM-REMOVAL" "obligation-order" 4 "obligation-outcome" ["claimed" "noop" "partial"] "obligation-work" ["repository-changing" "observational"]}
           {:e 106 "obligation" "O-CLAIM-DELIVERABLE" "obligation-order" 5 "obligation-outcome" ["claimed" "noop"] "obligation-role" "implementer" "obligation-work" ["repository-changing" "observational"]}
           {:e 107 "obligation" "O-CLAIM-NOOP-CONTINUE" "obligation-order" 6 "obligation-outcome" ["noop"] "obligation-work" ["repository-changing" "observational"]}
           {:e 108 "obligation" "O-CLAIM-PARTIAL-RECOVERY" "obligation-order" 7 "obligation-outcome" ["partial"] "obligation-work" ["repository-changing" "observational"]}
           {:e 109 "obligation" "O-CLAIM-DENIED-RECOVERY" "obligation-order" 8 "obligation-outcome" ["denied"] "obligation-work" ["repository-changing" "observational"]}]
   :expect {:actions []
            :denials #{}
            :obligations ["O-CLAIM-ACCEPTANCE" "O-CLAIM-BLOCKERS" "O-CLAIM-DELIVERABLE" "O-CLAIM-OWNERSHIP" "O-CLAIM-PUBLISH-EARLY" "O-CLAIM-REMOVAL"]}}

