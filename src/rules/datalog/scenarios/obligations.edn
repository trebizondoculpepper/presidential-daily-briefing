           {:e 109 "obligation" "O-CLAIM-DENIED-RECOVERY" "obligation-order" 8 "obligation-outcome" ["denied"] "obligation-work" ["repository-changing" "observational"]}]
   :expect {:actions []
            :denials #{}
            :obligations ["O-CLAIM-ACCEPTANCE" "O-CLAIM-BLOCKERS" "O-CLAIM-DELIVERABLE" "O-CLAIM-OWNERSHIP" "O-CLAIM-PUBLISH-EARLY" "O-CLAIM-REMOVAL"]}}

