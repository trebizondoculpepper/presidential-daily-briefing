            {:subject 101 :rule "D-ORDINARY" :kind "implement" :band 6}] :denials #{}}}
  {:id "owned-unfavorable-vs-new-easy" :doc "#651: an owned unfavorable claim precedes a new known easy win." :viewer {:role "implementer" :agent "me"}
   :facts [{:e 1 "forward-complete" true} {:e 100 "kind" "issue" "state" "OPEN" "number" 1 "target" "https://github.com/o/r/issues/1" "created" 1767225600001 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "current" "impact-size" "S" "complexity-state" "current" "complexity-size" "L" "head" "not-a-pr" "label" "agent:me" "owner" "me"} {:e 101 "kind" "issue" "state" "OPEN" "number" 2 "target" "https://github.com/o/r/issues/2" "created" 1767225600002 "labels-complete" true "reverse-complete" true "native-complete" true "open-blockers" 0 "blocking-complete" true "impact-state" "current" "impact-size" "L" "complexity-state" "current" "complexity-size" "S" "head" "not-a-pr" "label" "status:ready"}]
   :expect {:actions [{:subject 100 :rule "D-OWN-UNFAVORABLE" :kind "continue-implementation" :band 7}
