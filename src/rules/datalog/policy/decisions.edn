;; Decision rules: one map per rule keeps its ID, ordering, selection clauses, explanation and
;; evidence bindings together. Vector order is the rule index (10 + position), so moving a rule is
;; a policy change. Each {placeholder} in :why must name a witness: common, eligibility or :witnesses.
;; :affinity is the duty's role affinity (implementer, designer, shared or human; #651), an ordering key.
;; :owned marks a positively owned obligation (#651): it ranks before every new activity.
;; :denials documents every denial rule ID that rules.edn derives through implementation-deny.
{:decisions
 [{:id "D-ATTENTION"
   :purpose "Bring work explicitly addressed to this agent to the front of its queue."
   :kind "addressed-response"
   :band 1
   :preference 0
   :affinity "shared"
   :owned false
   :when [(open ?t) (addressed ?t)]
   :why "Explicitly addressed to you; respond before clearing attention."
   :codes ["addressed"]
   :witnesses {"addressedAgent" [[1 "agent" ?value] [?t "attention" ?value]]}}

  {:id "D-PR-FAIL"
   :purpose "Prioritize repairing failed PR checks before the change can progress toward merge."
   :kind "pr-follow-up"
   :band 2
   :preference 0
   :affinity "implementer"
   :owned false
   :when [(pr-action ?t) (pr-failure ?t)]
   :why "PR checks failed at head {head}; inspect and repair before merge."
   :codes ["pr-follow-up" "pr-failed-checks"]
   :witnesses {"failedChecks" [[?t "check" ?c] [?c "name" ?name] [?c "outcome" ?o] [1 "failure" ?o] [(str ?name ":" ?o) ?value]]}}

  {:id "D-PR-REVIEW"
   :purpose "Prioritize resolving substantive PR review findings on the current change."
   :kind "pr-follow-up"
   :band 2
   :preference 0
   :affinity "implementer"
   :owned false
   :when [(pr-action ?t) (pr-review ?t)]
   :why "PR has unresolved review findings at head {head}."
   :codes ["pr-follow-up" "pr-review-findings"]
   :witnesses {"reviewDecision" [[?t "review-decision" ?value]]
                 "unresolvedThreads" [[?t "thread" ?c] [?c "resolved" false] [(str "unresolved") ?value]]}}

  {:id "D-PR-CONFLICT"
   :purpose "Surface merge conflicts that need integration work."
   :kind "pr-follow-up"
   :band 2
   :preference 1
   :affinity "implementer"
   :owned false
   :when [(pr-action ?t) [?t "mergeable" "CONFLICTING"]]
   :why "PR has merge conflicts at head {head}."
   :codes ["pr-follow-up" "pr-conflicts"]
   :witnesses {"mergeable" [[?t "mergeable" ?value]]}}

  {:id "D-PR-MERGE"
   :purpose "Offer a final merge-inspection step for PRs whose checks and review evidence are satisfied."
   :kind "pr-follow-up"
   :band 2
   :preference 2
   :affinity "implementer"
   :owned false
   :when [(pr-action ?t) (clean-pr ?t)]
   :why "Current required checks are satisfied at head {head}; inspect the diff and review evidence, then consider merge."
   :codes ["pr-follow-up" "pr-inspect-merge"]
   :witnesses {"requiredChecksComplete" [[?t "required-evidence-complete" ?value]]
                 "complete" [[?t "pr-complete" ?value]]
                 "draft" [[?t "draft" ?value]]
                 "mergeState" [[?t "merge-state" ?value]]}}

  {:id "D-PR-INTEGRATE"
   :purpose "Surface accepted PRs that still need mergeability refreshed or integration work."
   :kind "pr-follow-up"
   :band 2
   :preference 3
   :affinity "implementer"
   :owned false
   :when [(pr-action ?t) (integrate-pr ?t)]
   :why "Accepted at head {head} (required checks satisfied, head reviewed, no fetched findings) but merge state is {mergeState}, mergeable {mergeable}; refresh mergeability or update the branch, then recheck before considering merge."
   :codes ["pr-follow-up" "pr-integrate"]
   :witnesses {"mergeable" [[?t "mergeable" ?value]]
                 "mergeState" [[?t "merge-state" ?value]]
                 "requiredChecksComplete" [[?t "required-evidence-complete" ?value]]}}

  {:id "D-DECIDE"
   :purpose "Bring recorded design decisions into the designer's queue before implementation proceeds."
   :kind "decide"
   :band 3
   :preference 0
   :affinity "designer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] [?t "label" "design:decision-needed"]]
   :why "Resolve the recorded design decision before implementation proceeds."
   :codes ["designer-duty"]
   :witnesses {"decisionLabel" [[?t "label" "design:decision-needed"] [(str "design:decision-needed") ?value]]}}

  {:id "D-DOCUMENT"
   :purpose "Make agreed decisions awaiting documentation visible to the designer."
   :kind "document"
   :band 3
   :preference 1
   :affinity "designer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] [?t "label" "design:documentation-needed"]]
   :why "An agreed decision needs documentation before implementation."
   :codes ["designer-duty"]
   :witnesses {"documentationLabel" [[?t "label" "design:documentation-needed"] [(str "design:documentation-needed") ?value]]}}

  {:id "D-DESIGN-REVIEW"
   :purpose "Surface design and documentation PRs for a designer's review."
   :kind "design-review"
   :band 3
   :preference 2
   :affinity "designer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (design-pr ?t) (not (own-follow-up ?t))]
   :why "Review the design/documentation PR at head {head}."
   :codes ["designer-duty"]
   :witnesses {"designEvidence" [(or-join [?t ?value] (and [?t "label" ?value] [1 "design-label" ?value]) (and [?t "closes" ?i] [?i "label" ?value] [1 "design-label" ?value]))]}}

  {:id "D-EASY"
   :purpose "Prefer known high-impact, low-effort opportunities when ordering work by impact."
   :kind "implement"
   :band 4
   :preference 0
   :affinity "implementer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (eligible ?t) (easy ?t) [1 "order" "impact"]]
   :why "Known easy win: impact {impact}, complexity {complexity}."
   :codes ["easy-win"]}

  {:id "D-OWN-EASY"
   :purpose "Highlight an active claim that is already known to have high impact and low effort."
   :kind "continue-implementation"
   :band 4
   :preference 0
   :affinity "implementer"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] (own-continuable ?t) (easy ?t)]
   :why "Continue your known easy win: impact {impact}, complexity {complexity}."
   :codes ["easy-win" "own-claim"]}

  {:id "D-COMPLEXITY-BOOST"
   :purpose "Prioritize estimating effort when known high impact could make the work valuable."
   :kind "estimate-complexity"
   :band 5
   :preference 0
   :affinity "implementer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (issue ?t) (needs-complexity ?t) (large-impact ?t)]
   :why "High impact {impact}, but effort is {complexityState}; estimate it to test implementation value."
   :codes ["assessment" "cross-role-boost"]}

  {:id "D-COMPLEXITY"
   :purpose "Surface missing or stale effort estimates so implementation choices use better evidence."
   :kind "estimate-complexity"
   :band 5
   :preference 1
   :affinity "implementer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (issue ?t) (needs-complexity ?t)]
   :why "Effort is {complexityState}; sizing improves the evidence for choosing work."
   :codes ["assessment"]}

  {:id "D-IMPACT-BOOST"
   :purpose "Prioritize assessing benefit when known low effort could reveal an easy win."
   :kind "assess-impact"
   :band 5
   :preference 0
   :affinity "designer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (issue ?t) (needs-impact ?t) (small-complexity ?t)]
   :why "Complexity {complexity} is small, but benefit is {impactState}; assess impact to test for an easy win."
   :codes ["assessment" "cross-role-boost"]}

  {:id "D-IMPACT"
   :purpose "Surface missing or stale benefit assessments for the designer to judge."
   :kind "assess-impact"
   :band 5
   :preference 1
   :affinity "designer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (issue ?t) (needs-impact ?t)]
   :why "Benefit is {impactState}; assess it before comparing implementation value."
   :codes ["assessment"]}

  {:id "D-BAD-ASSESSMENTS"
   :purpose "Inspect both unusable assessments together, so neither metric's repair is dropped (#651)."
   :kind "inspect-assessment"
   :band 5
   :preference 1
   :affinity "shared"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (issue ?t) (bad-complexity ?t) (bad-impact ?t)]
   :why "Complexity evidence is {complexityState} and impact evidence is {impactState}; inspect and correct both."
   :codes ["assessment" "inspection"]}

  {:id "D-BAD-COMPLEXITY"
   :purpose "Surface unusable effort evidence for inspection and correction."
   :kind "inspect-assessment"
   :band 5
   :preference 1
   :affinity "implementer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (issue ?t) (bad-complexity ?t)]
   :why "Complexity evidence is {complexityState}; inspect and correct the labels or provenance."
   :codes ["assessment" "inspection"]}

  {:id "D-BAD-IMPACT"
   :purpose "Surface unusable benefit evidence for inspection and correction."
   :kind "inspect-assessment"
   :band 5
   :preference 1
   :affinity "designer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (issue ?t) (bad-impact ?t)]
   :why "Impact evidence is {impactState}; inspect and correct the labels or provenance."
   :codes ["assessment" "inspection"]}

  {:id "D-ORDINARY"
   :purpose "Offer eligible implementation work after the more specific priorities are considered."
   :kind "implement"
   :band 6
   :preference 0
   :affinity "implementer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (eligible ?t)]
   :why "Eligible implementation: impact {impact} ({impactState}), complexity {complexity} ({complexityState})."
   :codes ["ordinary"]}

  {:id "D-ADOPT"
   :purpose "Offer preserved unowned PR work after a human-directed responsibility release, so an otherwise eligible agent may continue it."
   :kind "implement"
   :band 6
   :preference 1
   :affinity "implementer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (adoptable ?t) (not (implementation-denied ?t))]
   :why "Preserved unowned PR work: a human-directed release cleared {releaseFrom} from this ticket; an open PR continues it. Adopt it and become responsible. Impact {impact} ({impactState}), complexity {complexity} ({complexityState})."
   :codes ["ordinary" "adopt-unowned"]
   :witnesses {"releaseFrom" [[?t "release" ?r] (human-release ?t ?r) [?r "release-from" ?rfrom] [(str ?rfrom) ?value]]}}

  {:id "D-OWN"
   :purpose "Keep an agent's active implementation claim visible as continuation work."
   :kind "continue-implementation"
   :band 6
   :preference 0
   :affinity "implementer"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] (own-continuable ?t)]
   :why "Continue your active claim; impact {impact}, complexity {complexity}."
   :codes ["ordinary" "own-claim"]}

  {:id "D-REFINE"
   :purpose "Offer open refinement requests to the designer after human direction and own PR follow-up, ahead of new design, most downstream unlocks first."
   :kind "refine"
   :band 4
   :preference 1
   :affinity "designer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (refinement-work ?t) (refinement-unanswered ?t)]
   :why "Needs refinement: answer its blocking questions from existing designs and decisions, and escalate only what needs a human decision through needs-human."
   :codes ["designer-duty"]}

  {:id "D-REFINE-RESOLVE"
   :purpose "Offer refinement requests whose questions are all settled for resolution, returning them to estimation."
   :kind "refine"
   :band 4
   :preference 1
   :affinity "designer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (refinement-work ?t) (refinement-answered ?t) (not (refinement-unanswered ?t)) (not (refinement-empty ?t))]
   :why "Every blocking question is settled: resolve the refinement so the item returns for estimation. Resolving does not make it ready."
   :codes ["designer-duty"]}

  {:id "D-REFINE-EMPTY"
   :purpose "Inspect an open refinement request that records no blocking question; the boundary should have refused it."
   :kind "refine"
   :band 4
   :preference 1
   :affinity "designer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (refinement-work ?t) (refinement-empty ?t) (not (refinement-unanswered ?t)) (not (refinement-incomplete ?t))]
   :why "A refinement request records no blocking question; inspect it and record the concrete question or withdraw the request."
   :codes ["designer-duty"]}

  {:id "D-REFINE-INCOMPLETE"
   :purpose "Inspect refinement whose evidence could not be read completely instead of presenting it as answered."
   :kind "refine"
   :band 4
   :preference 1
   :affinity "designer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (refinement-work ?t) (refinement-incomplete ?t) (not (refinement-unanswered ?t))]
   :why "Refinement evidence is incomplete; inspect the ticket before treating its questions as settled."
   :codes ["designer-duty"]}

  {:id "D-REESTIMATE"
   :purpose "Return resolved refinement to estimation: an earlier estimate does not stand once refinement has been resolved."
   :kind "estimate-complexity"
   :band 5
   :preference 0
   :affinity "implementer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (awaiting-reestimate ?t) (issue ?t) (open ?t) (not (claimed ?t))]
   :why "Refinement was resolved; re-estimate assuming its dependencies are complete. Estimation does not make the item ready."
   :codes ["ordinary"]}

  {:id "D-DESIGN"
   :purpose "Offer design work when a required design contract is missing."
   :kind "design"
   :band 6
   :preference 0
   :affinity "designer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (design-eligible ?t)]
   :why "A design contract is missing. Impact {impact}, complexity {complexity}."
   :codes ["ordinary"]
   :witnesses {"designLabel" [[?t "label" "status:needs-design"] [(str "status:needs-design") ?value]]}}

  {:id "D-UNFAVORABLE"
   :purpose "Flag eligible work whose known effort is high relative to its benefit."
   :kind "implement"
   :band 7
   :preference 0
   :affinity "implementer"
   :owned false
   :when [[1 "role" ?role] [(not= ?role "human")] (eligible ?t) (unfavorable ?t) [1 "order" "impact"]]
   :why "High effort for limited benefit: impact {impact}, complexity {complexity}; reconsider or split."
   :codes ["unfavorable"]}

  {:id "D-OWN-UNFAVORABLE"
   :purpose "Prompt reconsideration of active work with high effort and limited known benefit."
   :kind "continue-implementation"
   :band 7
   :preference 0
   :affinity "implementer"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] (own-continuable ?t) (unfavorable ?t)]
   :why "Your active work has impact {impact} and complexity {complexity}; reconsider or split before continuing."
   :codes ["unfavorable" "own-claim"]}

  ;; Retained claims (#413, doc/design/blocked-retained-claims.md). The host reads each own
  ;; claim's activity with the same verified reader as the claim guard; absent facts mean the
  ;; read was not made (offline), so the ordinary continuation rules above apply unchanged.
  {:id "D-OWN-RESUME"
   :purpose "Surface retained claims whose recorded wait has cleared and need explicit resumption."
   :kind "resume-claim"
   :band 3
   :preference 0
   :affinity "shared"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] (own-issue ?t) [?t "claim-activity" "resume-required"]]
   :why "What your claim waited on has cleared ({waitReason}); resume it explicitly before starting other work."
   :codes ["own-claim" "resume-required"]
   :witnesses {"waitReason" [[?t "wait-reason" ?value]]}}

  {:id "D-REVIEW-OWNED"
   :purpose "Prompt a review of multiple retained implementation claims before starting more work."
   :kind "review-owned-work"
   :band 3
   :preference 1
   :affinity "shared"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] [1 "owned-review-subject" ?t] (own-issue ?t) [1 "owned-claims" ?n] [(> ?n 1)] [1 "owned-claims-complete" true]]
   :why "You retain {ownedClaims} implementation claims; review which to finish, justify as waiting, release or reassign before starting more work."
   :codes ["own-claim" "review-owned-work"]
   :witnesses {"ownedClaims" [[1 "owned-claims" ?value]]}}

  {:id "D-REVIEW-OWNED-PARTIAL"
   :purpose "Prompt review of the observed retained claims while making incomplete ownership evidence explicit."
   :kind "review-owned-work"
   :band 3
   :preference 1
   :affinity "shared"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] [1 "owned-review-subject" ?t] (own-issue ?t) [1 "owned-claims" ?n] [(> ?n 1)] [1 "owned-claims-complete" false]]
   :why "You retain at least {ownedClaims} implementation claims (the claim inventory is incomplete); review which to finish, justify as waiting, release or reassign before starting more work."
   :codes ["own-claim" "review-owned-work" "inspection"]
   :witnesses {"ownedClaims" [[1 "owned-claims" ?value]]}}

  {:id "D-INVENTORY-UNKNOWN"
   :purpose "Surface an incomplete claim inventory even when no active claim was observed."
   :kind "inspect-ownership"
   :band 3
   :preference 3
   :affinity "shared"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] [?t "ownership-inventory" true] [1 "owned-claims" 0] [1 "owned-claims-complete" false]]
   :why "Your claim inventory is incomplete and no claim was observed; inspect your ownership before claiming more work."
   :codes ["inspection" "inventory-unknown"]}

  {:id "D-OWNED-INCOMPLETE"
   :purpose "Keep an observed claim visible while asking the agent to verify its incomplete ownership inventory."
   :kind "inspect"
   :band 3
   :preference 3
   :affinity "shared"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] [1 "owned-review-subject" ?t] (own-issue ?t) [1 "owned-claims" 1] [1 "owned-claims-complete" false]]
   :why "Your claim inventory is incomplete and only this claim was observed; inspect your ownership before claiming more work."
   :codes ["own-claim" "inspection"]}

  {:id "D-OWN-HELD-BACK"
   :purpose "Manage an owned claim that a native blocker or an outstanding prerequisite holds back (#651)."
   :kind "inspect"
   :band 3
   :preference 2
   :affinity "shared"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] (own-held-back ?t)]
   :why "Your claim is held back by {heldBack}; inspect it, then advance the blocker or question, hand over, or release the claim. It is not ready to continue."
   :codes ["owned-blocked" "own-claim"]
   :witnesses {"heldBack" [(or-join [?t ?value] (and [?t "label" ?value] [1 "prerequisite" ?value]) (and [?t "open-blockers" ?n] [(> ?n 0)] [(str ?n " open native blocker(s)") ?value]) (and [?t "blocker" ?i] [?i "state" "OPEN"] [?i "number" ?b] [(str "open blocker #" ?b) ?value]) (and (needs-refinement ?t) [(str "open refinement") ?value]) (and (awaiting-reestimate ?t) [(str "resolved refinement awaiting re-estimation") ?value]) (and [?t "refinement-complete" false] [(str "unknown refinement evidence") ?value]))]}}

  {:id "D-OWN-UNKNOWN"
   :purpose "Surface a retained claim whose activity or wait evidence cannot be established."
   :kind "inspect"
   :band 3
   :preference 2
   :affinity "shared"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] (own-issue ?t) [?t "claim-activity" "unknown"]]
   :why "Your claim's activity is unknown ({waitReason}); inspect its wait evidence. Unknown is never waiting, so no other claim is admitted."
   :codes ["own-claim" "inspection"]
   :witnesses {"waitReason" [[?t "wait-reason" ?value]]}}

  {:id "D-OWN-PR-INCOMPLETE"
   :purpose "Inspect an owned PR whose checks, reviews or threads were not read completely, instead of treating it as clean or waiting (#651)."
   :kind "inspect"
   :band 3
   :preference 2
   :affinity "shared"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] (own-pr-incomplete ?t)]
   :why "Your PR's checks, reviews or threads were not read completely at head {head}; inspect it before treating it as waiting or clean."
   :codes ["own-pr" "evidence-incomplete"]}

  {:id "D-OWN-PR-WAIT"
   :purpose "Keep an owned PR that only waits on its checks visible as an owned wait, without inventing repair work (#651)."
   :kind "inspect"
   :band 8
   :preference 1
   :affinity "shared"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] (own-pr-waiting ?t)]
   :why "Your PR's checks are still running at head {head}; there is nothing to repair yet. Check back once they finish."
   :codes ["own-pr" "waiting-checks"]}

  {:id "D-OWN-WAIT"
   :purpose "Keep a verified waiting claim visible without suggesting immediate continuation."
   :kind "wait-claim"
   :band 8
   :preference 0
   :affinity "shared"
   :owned true
   :when [[1 "role" ?role] [(not= ?role "human")] (own-issue ?t) [?t "claim-activity" "waiting"]]
   :why "Waiting: {waitReason}. You keep this claim; nothing to do on it until that clears."
   :codes ["own-claim" "waiting"]
   :witnesses {"waitReason" [[?t "wait-reason" ?value]]}}

  {:id "D-INSPECT"
   :purpose "Show work needing eligibility or platform evidence without declaring it ready for pickup."
   :kind "inspect"
   :band 6
   :preference 0
   :affinity "shared"
   :owned false
   :when [(issue ?t) (possible ?t) (uncertain ?t) [1 "role" ?role] [(not= ?role "human")]]
   :why "Eligibility is unproven: inspect incomplete evidence or state the required platform."
   :codes ["ordinary" "inspection"]
   :witnesses {"uncertainty" [(or-join [?t ?value] (and [?t "labels-complete" false] [(str "labels incomplete") ?value]) (and [?t "native-complete" false] [(str "native dependencies incomplete") ?value]) (and (not (closing-complete ?t)) [(str "closing PR evidence incomplete") ?value]) (and (platform-unknown ?t) [(str "viewer platform unknown") ?value]))]}}

  ;; Human briefing (doc/design/human-briefing.md, #457): input a named human owes. Explicit
  ;; items come from trusted records or attention; inferred ones are candidates, never requests.
  {:id "D-HUMAN-ASK-YOU"
   :purpose "Put trusted questions explicitly routed to the selected human ahead of general human attention."
   :kind "answer-questions"
   :band 1
   :preference 0
   :affinity "human"
   :owned false
   :when [[1 "role" "human"] (open-question ?t) (asks-viewer ?t)]
   :why "A trusted question record routed to you ({routedTo}) awaits answers on the ticket."
   :codes ["explicit" "addressed"]
   :witnesses {"routedTo" [(asking-record ?t ?r) [?r "record-to" ?value]]}}

  {:id "D-HUMAN-ASK"
   :purpose "Surface trusted questions routed to a human so their answers can be recorded on the ticket."
   :kind "answer-questions"
   :band 3
   :preference 0
   :affinity "human"
   :owned false
   :when [[1 "role" "human"] (open-question ?t) (not (asks-viewer ?t))]
   :why "A trusted question record routed to {routedTo} awaits answers on the ticket."
   :codes ["explicit"]
   :witnesses {"routedTo" [(asking-record ?t ?r) [?r "record-to" ?value]]}}

  {:id "D-HUMAN-UNVERIFIED"
   :purpose "Show question labels with unverified authorship as inferred attention needing confirmation."
   :kind "decide"
   :band 3
   :preference 1
   :affinity "human"
   :owned false
   :when [[1 "role" "human"] (open-unrecorded ?t) (unverified-record ?t)]
   :why "Labelled {questionLabel}; a question record exists but its author's authority is unverified. Inferred: confirm the decision needed."
   :codes ["inferred"]
   :witnesses {"questionLabel" [[?t "label" ?value] [1 "question-label" ?value]]}}

  {:id "D-HUMAN-DECIDE"
   :purpose "Show decision labels without a trusted question record as inferred human attention."
   :kind "decide"
   :band 3
   :preference 2
   :affinity "human"
   :owned false
   :when [[1 "role" "human"] (open-unrecorded ?t)]
   :why "Labelled {questionLabel} without a trusted question record. Inferred: a decision may be needed."
   :codes ["inferred"]
   :witnesses {"questionLabel" [[?t "label" ?value] [1 "question-label" ?value]]}}

  ;; #414: a question outlives its source's closure until explicitly resolved or withdrawn.
  {:id "D-HUMAN-ORPHANED-YOU"
   :purpose "Keep unresolved trusted questions routed to the selected human visible after ticket closure."
   :kind "orphaned-question"
   :band 1
   :preference 1
   :affinity "human"
   :owned false
   :when [[1 "role" "human"] (orphan-asks-viewer ?t)]
