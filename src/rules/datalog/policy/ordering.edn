;; Every sort column is inferred by these rules; the host only runs a fixed lexicographic
;; comparator over the emitted keys, in :comparison order.
;; :overrides are the declared precedence exceptions between rules of the same kind that a
;; generic band/preference comparison does not decide: when both rules match the same subject,
;; the winner overrides the loser. The engine's :declared-overrides query and `pdb rules` both
;; read this list; nothing else hard-codes a rule pair.
{:overrides
 [{:winner "D-EASY" :loser "D-ORDINARY"}
  {:winner "D-UNFAVORABLE" :loser "D-ORDINARY"}
  {:winner "D-OWN-EASY" :loser "D-OWN"}
  {:winner "D-OWN-UNFAVORABLE" :loser "D-OWN"}]
 :comparison ["ownership" "attention" "affinity" "band" "group" "primary" "urgency" "unlocks" "own" "incomplete" "created" "number" "target" "kind"]
 :rules
 [
 [(selected ?t ?r) [?t "matched" ?r] (not [?t "overridden" ?r])]
 [(age ?t ?r ?created) [?r "kind" "implement"] [1 "order" "oldest"] [?t "created" ?created]]
 [(age ?t ?r ?created) [?r "kind" "implement"] [1 "order" "newest"] [?t "created" ?c] [(- 0 ?c) ?created]]
 [(keys ?t ?r ?b ?g ?p ?u ?un ?own ?inc ?created) (selected ?t ?r) [?r "band" ?b] [(<= ?b 3)] (fixed-key ?t ?r ?b ?g ?p) [(+ 0 0) ?u] [(+ 0 0) ?un] [(+ 0 0) ?own] [(+ 0 0) ?inc] [?t "number" ?created]]
 [(fixed-key ?t ?r ?b ?g ?p) [?t "kind" _] [?r "band" ?b] [(= ?b 1)] [(+ 0 0) ?g] [(+ 0 0) ?p]]
 [(fixed-key ?t ?r ?b ?g ?p) [?t "linked-key" ?g] [?r "band" ?b] [(= ?b 2)] [?r "preference" ?p]]
 [(fixed-key ?t ?r ?b ?g ?p) [?t "ownership-inventory" true] [?r "band" ?b] [(= ?b 3)] [?r "preference" ?g] [(+ 0 0) ?p]]
 [(fixed-key ?t ?r ?b ?g ?p) [?r "band" ?b] [(= ?b 3)] [?r "preference" ?g] [?t "active-count" ?n] [(- 0 ?n) ?p]]
 [(keys ?t ?r ?b ?g ?p ?u ?un ?own ?inc ?created) (selected ?t ?r) [?r "band" ?b] [(> ?b 3)] (age ?t ?r ?created) [(+ 0 1) ?g] [(+ 0 0) ?p] [(+ 0 0) ?u] [(+ 0 0) ?un] [(+ 0 0) ?own] [(+ 0 0) ?inc]]
 [(keys ?t ?r ?b ?g ?p ?u ?un ?own ?inc ?created) (selected ?t ?r) [?r "band" ?b] [(> ?b 3)] (not (age ?t ?r _)) [(+ 0 0) ?g] [?r "preference" ?p] [?t "urgency-key" ?u] [?t "own-key" ?own] [?t "incomplete-key" ?inc] [?t "created" ?created] [?r "kind" ?k] (or-join [?t ?k ?un] (and [1 "assessment-kind" ?k] [(+ 0 0) ?un]) (and (not [1 "assessment-kind" ?k]) [?t "unlock-count" ?n] [(- 0 ?n) ?un]))]
 ;; #651/#652: one activity pool for both roles, ranked ownership first, then directed attention,
 ;; then role affinity, then the existing lifecycle bands. Owned obligations precede all new work.
 ;; Ownership without rule negation (#652 performance): declared owned obligations, or a
 ;; linked subject for the duty kinds an agent can own by linkage; everything else is new work.
 [(ownership-key ?t ?r ?o) [1 "role" "human"] [?r "rule" _] [(+ 0 0) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" true] [(+ 0 0) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "pr-follow-up"] [?t "linked-key" -1] [(+ 0 0) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "pr-follow-up"] [?t "linked-key" 0] [(+ 0 1) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "addressed-response"] [?t "linked-key" -1] [(+ 0 0) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "addressed-response"] [?t "linked-key" 0] [(+ 0 1) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "decide"] [?t "linked-key" -1] [(+ 0 0) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "decide"] [?t "linked-key" 0] [(+ 0 1) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "document"] [?t "linked-key" -1] [(+ 0 0) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "document"] [?t "linked-key" 0] [(+ 0 1) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "design"] [?t "linked-key" -1] [(+ 0 0) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "design"] [?t "linked-key" 0] [(+ 0 1) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "design-review"] [?t "linked-key" -1] [(+ 0 0) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" "design-review"] [?t "linked-key" 0] [(+ 0 1) ?o]]
 [(ownership-key ?t ?r ?o) [1 "role" ?vr] [(not= ?vr "human")] [?r "owned" false] [?r "kind" ?k] [(not= ?k "pr-follow-up")] [(not= ?k "addressed-response")] [(not= ?k "decide")] [(not= ?k "document")] [(not= ?k "design")] [(not= ?k "design-review")] [(+ 0 1) ?o]]
 [(attention-key ?r ?a) [1 "role" "human"] [?r "rule" _] [(+ 0 0) ?a]]
 [(attention-key ?r ?a) [1 "role" ?vr] [(not= ?vr "human")] [?r "kind" "addressed-response"] [(+ 0 0) ?a]]
 [(attention-key ?r ?a) [1 "role" ?vr] [(not= ?vr "human")] [?r "kind" ?k] [(not= ?k "addressed-response")] [(+ 0 1) ?a]]
 [(affinity-key ?r ?f) [?r "affinity" ?x] [1 "role" ?v] [(= ?x ?v)] [(+ 0 0) ?f]]
 [(affinity-key ?r ?f) [?r "affinity" "shared"] [(+ 0 0) ?f]]
 [(affinity-key ?r ?f) [?r "affinity" ?x] [1 "role" ?v] [(not= ?x ?v)] [(not= ?x "shared")] [(+ 0 1) ?f]]
 [(ranked ?t ?r ?o ?a ?f ?b ?g ?p ?u ?un ?own ?inc ?created) (keys ?t ?r ?b ?g ?p ?u ?un ?own ?inc ?created) (ownership-key ?t ?r ?o) (attention-key ?r ?a) (affinity-key ?r ?f)]
 ]}
