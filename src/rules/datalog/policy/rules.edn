;; Derived predicates for the next-action policy (DataScript Datalog, not Prolog).
;; Absence is usable only after the corresponding complete relation.
;; Attributes are strings, never keywords: keyword attributes from JavaScript fail at query time.
;; Entity 1 holds the viewer and constant sets; see schema.edn.
[
[(issue ?t) [?t "kind" "issue"]]
[(pr ?t) [?t "kind" "pr"]]
[(open ?t) [?t "state" "OPEN"]]
[(claimed ?t) [?t "owner" ?a]]
[(mine ?t) [1 "agent" ?a] [?t "owner" ?a]]
[(mine-linked ?t) (mine ?t)]
[(mine-linked ?t) [1 "agent" ?a] [?t "responsible" ?a]]
[(mine-linked ?t) [?t "closes" ?i] (mine ?i)]
[(addressed ?t) [1 "agent" ?a] [?t "attention" ?a]]
[(parked ?t) [?t "label" "status:parked"]]
[(foreground ?t) (open ?t) (not (parked ?t))]
;; Repository-level recovery is context, never a fabricated owned issue.
[(foreground ?t) [?t "ownership-inventory" true]]
[(foreground ?t) (open ?t) (addressed ?t)]
;; Human input is waiting whatever the ticket's parking: the human view sees parked work (#457).
[(foreground ?t) (open ?t) [1 "role" "human"]]
;; #413: a claim the live read found released since the snapshot is no longer the viewer's.
[(own-issue ?t) (issue ?t) (open ?t) (mine ?t) (not [?t "claim-activity" "not-owned"])]
;; #413: a retained claim with no activity record is active (legacy claims count as active);
;; waiting, resume-required and unknown claims are not continued as implementation.
[(own-active ?t) (own-issue ?t) (not [?t "claim-activity" _])]
[(own-active ?t) (own-issue ?t) [?t "claim-activity" "active"]]
;; #652: an owned active claim held back by an open native blocker or a prerequisite label (an
;; outstanding question or design need) is managed, never continued as implementation.
[(own-held-back ?t) (own-active ?t) (blocked ?t)]
[(own-held-back ?t) (own-active ?t) (prerequisite ?t)]
[(own-continuable ?t) (own-active ?t) (not (blocked ?t)) (not (prerequisite ?t))]
;; A closed source stays in the human view while a trusted question on it is unsettled (#414).
[(foreground ?t) [1 "role" "human"] (orphan-source ?t)]
[(platform-ok ?t) [?t "labels-complete" true] (not [?t "platform" _])]
[(platform-ok ?t) [1 "platform" ?p] [?t "platform" ?p]]
[(platform-unknown ?t) [?t "platform" _] [1 "platform" ""]]
[(available ?t) [?t "label" "status:ready"]]
[(available ?t) [?t "label" "status:incomplete"]]
[(prerequisite ?t) [?t "label" ?l] [1 "prerequisite" ?l]]
[(has-closing ?t) [?t "closing" ?p]]
[(has-closing ?t) [?p "closes" ?t] (open ?p)]
[(closing-complete ?t) [?t "reverse-complete" true]]
[(closing-complete ?t) [?t "kind" _] [1 "forward-complete" true]]
[(otherwise ?t) (issue ?t) (open ?t) (available ?t) [?t "labels-complete" true] (platform-ok ?t) (closing-complete ?t) (not (claimed ?t)) (not (has-closing ?t)) (not (prerequisite ?t))]
[(blocked ?t) [?t "open-blockers" ?n] [(> ?n 0)]]
[(blocked ?t) [?t "blocker" ?i] [?i "state" "OPEN"]]
[(implementation-permit ?t) (issue ?t) (open ?t) (available ?t)]
[(implementation-deny ?t ?r) (issue ?t) (claimed ?t) [(str "D-DENY-CLAIM") ?r]]
[(implementation-deny ?t ?r) (issue ?t) (prerequisite ?t) [(str "D-DENY-PREREQUISITE") ?r]]
[(implementation-deny ?t ?r) (issue ?t) (has-closing ?t) [(str "D-DENY-OPEN-PR") ?r]]
[(implementation-deny ?t ?r) (issue ?t) (blocked ?t) [(str "D-DENY-BLOCKER") ?r]]
[(implementation-deny ?t ?r) (issue ?t) [?t "labels-complete" false] [(str "D-DENY-LABELS-UNKNOWN") ?r]]
[(implementation-deny ?t ?r) (issue ?t) [?t "native-complete" false] [(str "D-DENY-NATIVE-UNKNOWN") ?r]]
[(implementation-deny ?t ?r) (issue ?t) (not (closing-complete ?t)) [(str "D-DENY-CLOSING-UNKNOWN") ?r]]
[(implementation-deny ?t ?r) (issue ?t) (not (platform-ok ?t)) [(str "D-DENY-PLATFORM") ?r]]
;; #413: an incomplete inventory cannot rule out omitted active claims, even if every
;; observed claim is waiting; new pickup is denied rather than inviting a claim that the guard may refuse.
[(implementation-deny ?t ?r) (issue ?t) (open ?t) (available ?t) (not (claimed ?t)) [1 "owned-claims-complete" false] [(str "D-DENY-INVENTORY-UNKNOWN") ?r]]
[(implementation-denied ?t) (implementation-deny ?t ?r)]
[(eligible ?t) (implementation-permit ?t) (not (implementation-denied ?t))]
[(design-eligible ?t) (issue ?t) (open ?t) [?t "label" "status:needs-design"] [?t "labels-complete" true] (platform-ok ?t) (closing-complete ?t) (not (claimed ?t)) (not (has-closing ?t)) (not [?t "label" "design:decision-needed"])]
[(possible ?t) (available ?t) (not (claimed ?t)) (not (prerequisite ?t)) (not (blocked ?t)) (not (has-closing ?t))]
[(possible ?t) [?t "label" "status:needs-design"] (not (claimed ?t)) (not (has-closing ?t))]
[(uncertain ?t) [?t "labels-complete" false]]
[(uncertain ?t) [?t "native-complete" false]]
[(uncertain ?t) [?t "kind" _] (not (closing-complete ?t))]
[(uncertain ?t) (platform-unknown ?t)]
[(large-impact ?t) [?t "impact-state" "current"] [?t "impact-size" ?s] [1 "large" ?s]]
[(small-complexity ?t) [?t "complexity-state" "current"] [?t "complexity-size" ?s] [1 "small" ?s]]
[(easy ?t) (large-impact ?t) (small-complexity ?t)]
[(unfavorable ?t) [?t "impact-state" "current"] [?t "impact-size" ?i] [1 "small" ?i] [?t "complexity-state" "current"] [?t "complexity-size" ?c] [1 "large" ?c]]
[(needs-complexity ?t) [?t "complexity-state" ?s] [1 "needs-assessment" ?s]]
[(needs-impact ?t) [?t "impact-state" ?s] [1 "needs-assessment" ?s]]
[(bad-complexity ?t) [?t "complexity-state" ?s] [1 "bad-assessment" ?s]]
[(bad-impact ?t) [?t "impact-state" ?s] [1 "bad-assessment" ?s]]
[(design-pr ?t) (pr ?t) [?t "label" ?l] [1 "design-label" ?l]]
[(design-pr ?t) (pr ?t) [?t "closes" ?i] [?i "label" ?l] [1 "design-label" ?l]]
[(pr-failure ?t) [?t "check" ?c] [?c "outcome" ?o] [1 "failure" ?o]]
[(pr-pending ?t) [?t "check" ?c] [?c "outcome" ?o] [1 "pending" ?o] (not [?c "required" "advisory"])]
[(pr-pending ?t) [?t "missing-required" ?m]]
[(pr-unknown ?t) [?t "check" ?c] [?c "outcome" ?o] (not [1 "known-check" ?o])]
[(pr-review ?t) [?t "review-decision" "CHANGES_REQUESTED"]]
[(pr-review ?t) [?t "thread" ?c] [?c "resolved" false]]
[(pr-review ?t) (head-findings ?t)]
;; Required-check readiness is target evidence, never a universal check name (#676).
[(required-unsatisfied ?t) [?t "check" ?c] [?c "required" "required"] [?c "outcome" ?o] [(not= ?o "SUCCESS")]]
[(required-unknown ?t) [?t "check" ?c] [?c "required" "unknown"]]
[(requirements-satisfied ?t) [?t "required-evidence-complete" true] (not (required-unsatisfied ?t)) (not (required-unknown ?t)) (not [?t "missing-required" _])]
;; The engine materializes the native check-ready query once; hosts cannot supply this fact.
[(verified ?t) [?t "native-checks-satisfied" true]]
[(check-blocker ?t ?code ?reason) [(str "RC-COVERAGE") ?code] [?t "required-evidence-complete" false] (not [?t "required-evidence-gap" _]) [(str "Required-check evidence incomplete") ?reason]]
[(check-blocker ?t ?code ?reason) [(str "RC-REQUIREDNESS") ?code] [?t "check" ?c] [?c "required" "unknown"] [?c "name" ?name] [(str "Requiredness unknown: " ?name) ?reason]]
[(check-blocker ?t ?code ?reason) [(str "RC-GAP") ?code] [?t "required-evidence-gap" ?gap] [(str "Required-check evidence unknown: " ?gap) ?reason]]
[(check-blocker ?t ?code ?reason) [(str "RC-MISSING") ?code] [?t "missing-required" ?name] [(str "Required check not yet reported: " ?name) ?reason]]
[(check-blocker ?t ?code ?reason) [(str "RC-OUTCOME") ?code] [?t "check" ?c] [?c "required" "required"] [?c "name" ?name] [?c "outcome" ?o] [(not= ?o "SUCCESS")] [(str "Required check " ?name " is " ?o) ?reason]]
[(clean-pr ?t) (pr ?t) [?t "pr-complete" true] [?t "draft" false] [?t "mergeable" "MERGEABLE"] [?t "merge-state" ?m] [1 "merge-state" ?m] (verified ?t) (not (pr-failure ?t)) (not (pr-pending ?t)) (not (pr-unknown ?t)) (not (pr-review ?t))]
;; Review coverage (#301): legacy unless the repository declared a registered policy. Absent
;; review-coverage is legacy; `unknown` accepts nothing. Provider facts are host-normalized:
;; authenticated integration, bound to the full head, one state per provider.
[(legacy-coverage ?t) [?t "head" _] (not-join [?t] [1 "review-coverage" "any"]) (not-join [?t] [1 "review-coverage" "unknown"])]
[(head-reviewed ?t) (legacy-coverage ?t) [?t "head" ?h] [?t "review" ?r] [?r "review-state" "APPROVED"] [?r "review-commit" ?h]]
[(head-reviewed ?t) (legacy-coverage ?t) [?t "head" ?h] [?t "receipt" ?c] [?c "receipt-commit" ?h] [?c "receipt-status" "completed"] [?c "receipt-findings" false]]
[(head-reviewed ?t) [1 "review-coverage" "any"] [?t "head" ?h] [?t "provider-review" ?p] [?p "provider-state" "accepted"] [?p "provider-commit" ?h]]
[(head-findings ?t) (legacy-coverage ?t) [?t "head" ?h] [?t "receipt" ?c] [?c "receipt-commit" ?h] [?c "receipt-findings" true]]
[(head-findings ?t) [?t "head" ?h] [?t "provider-review" ?p] [?p "provider-state" "findings"] [?p "provider-commit" ?h]]
[(accepted-pr ?t) (head-reviewed ?t) (not (head-findings ?t)) [?t "pr-complete" true] [?t "draft" false] (verified ?t) (not (pr-failure ?t)) (not (pr-pending ?t)) (not (pr-unknown ?t)) (not (pr-review ?t)) (not [?t "mergeable" "CONFLICTING"])]
[(refresh-needed ?t) [?t "mergeable" ?m] [1 "unknown-mergeable" ?m]]
[(refresh-needed ?t) [?t "merge-state" ?m] [1 "refresh-state" ?m]]
[(integrate-pr ?t) (accepted-pr ?t) (refresh-needed ?t)]
[(follow-up ?t) (pr-failure ?t)]
[(follow-up ?t) (pr-review ?t)]
[(follow-up ?t) (pr ?t) [?t "mergeable" "CONFLICTING"]]
[(follow-up ?t) (clean-pr ?t)]
[(follow-up ?t) (integrate-pr ?t)]
[(own-follow-up ?t) (mine-linked ?t) (follow-up ?t)]
[(pr-action ?t) (pr ?t) [1 "role" ?viewer] [(not= ?viewer "human")]]
[(question-labelled ?t) [?t "label" ?l] [1 "question-label" ?l]]
[(trusted-record ?t ?r) [?t "question-record" ?r] [?r "record-trust" "trusted"]]
[(unverified-record ?t) [?t "question-record" ?r] [?r "record-trust" "unverified"]]
;; A record asks while it is pending and not explicitly settled (#414). A v2 question ignores
;; labels: only an explicit resolve or withdraw settles it. A legacy record (v1, or a fact with no
;; version) asks only while a question label remains.
[(record-pending ?t ?r) [?r "record-version" 2]]
[(record-pending ?t ?r) [?r "record-version" 1] (question-labelled ?t)]
[(record-pending ?t ?r) [?t "question-record" ?r] (not [?r "record-version" _]) (question-labelled ?t)]
[(asking-record ?t ?r) (trusted-record ?t ?r) (not (record-settled ?r)) (record-pending ?t ?r)]
[(has-asking-record ?t) (asking-record ?t ?r)]
[(open-question ?t) (issue ?t) (open ?t) (has-asking-record ?t)]
[(open-unrecorded ?t) (issue ?t) (open ?t) (question-labelled ?t) (not (has-asking-record ?t))]
[(asks-viewer ?t) (asking-record ?t ?r) [?r "record-to" ?a] [1 "agent" ?a]]
;; Questions on closed sources (#414, doc/reports/closed-question-discovery.md). Closure, merge
;; and label removal never settle a v2 question: only an explicit resolve or withdraw does. A
;; legacy v1 question keeps label removal as its resolution. An unknown outcome is never settled.
[(closed ?t) [?t "state" "CLOSED"]]
[(record-settled ?r) [?r "record-outcome" "resolved"]]
[(record-settled ?r) [?r "record-outcome" "withdrawn"]]
[(orphaned-record ?t ?r) (issue ?t) (closed ?t) (trusted-record ?t ?r) [?r "record-outcome" "none"] (record-pending ?t ?r)]
[(orphan-unknown ?t ?r) (issue ?t) (closed ?t) (trusted-record ?t ?r) [?r "record-outcome" "unknown"] (record-pending ?t ?r)]
[(orphan-unknown ?t ?r) (issue ?t) (closed ?t) (trusted-record ?t ?r) [?r "record-version" 1] (not (record-settled ?r)) [?t "labels-complete" false] (not (question-labelled ?t))]
[(has-orphaned ?t) (orphaned-record ?t ?r)]
[(has-orphan-unknown ?t) (orphan-unknown ?t ?r)]
[(orphan-source ?t) (has-orphaned ?t)]
[(orphan-source ?t) (has-orphan-unknown ?t)]
[(orphan-asks-viewer ?t) (orphaned-record ?t ?r) [?r "record-to" ?a] [1 "agent" ?a]]
;; Native human-attention section grouping (#643, doc/design/human-briefing.md): items with any
;; unknown question resolution appear in Waiting; actionable items requiring the human's input or
;; review appear in Input.
[(human-waiting-item ?t) [1 "role" "human"] (has-orphan-unknown ?t)]
[(human-attention-section ?t ?section ?code ?reason) (human-waiting-item ?t) [(str "waiting") ?section] [(str "HS-WAITING-UNKNOWN") ?code] [(str "Whether this question was resolved could not be established; shown under Waiting for inspection, not as answered.") ?reason]]
[(human-attention-section ?t ?section ?code ?reason) [1 "role" "human"] [?t "matched" _] (not (human-waiting-item ?t)) [(str "input") ?section] [(str "HS-INPUT-ACTIONABLE") ?code] [(str "Requires human input or review from the observed evidence.") ?reason]]
;; Native PR-readiness diagnostics (#707): every current blocker for one PR, decided by rules.
[(declared-review-coverage ?t) [?t "policy-effective" "codex-or-coderabbit"]]
[(declared-review-coverage ?t) [?t "policy-effective" "codex-or-copilot"]]
[(optional-review-detail ?t) (declared-review-coverage ?t) [?t "policy-head-reviewed" true]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-DRAFT") ?code] [?t "draft" true] [(str "draft") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) (check-blocker ?t ?code ?reason)]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-CHECK-FAILED") ?code] [?t "check" ?c] [?c "name" ?name] [?c "outcome" ?o] [1 "failure" ?o] [(not= ?o "CANCELLED")] [(str "check " ?name " failed") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-CHECK-CANCELLED") ?code] [?t "check" ?c] [?c "name" ?name] [?c "outcome" "CANCELLED"] [?c "no-run-time" true] [(str "check " ?name " cancelled without running (likely infrastructure, not a code defect): verification incomplete") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-CHECK-CANCELLED") ?code] [?t "check" ?c] [?c "name" ?name] [?c "outcome" "CANCELLED"] [?c "no-run-time" false] [(str "check " ?name " cancelled: verification incomplete") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-CHECK-PENDING") ?code] [?t "pending-count" ?n] [(> ?n 0)] [(str ?n " check(s) still pending: waiting") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-CONFLICTS") ?code] [?t "mergeable" "CONFLICTING"] [(str "merge conflicts with the base branch") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-MERGEABLE-UNKNOWN") ?code] [?t "mergeable" "UNKNOWN"] [(str "mergeability unknown (GitHub still computing)") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-BEHIND") ?code] [?t "merge-state" "BEHIND"] [?t "base-ref" ?base] [(str "branch is behind " ?base ": update it before merging") ?reason]]
[(pr-merge-state-exempt ?t) [?t "merge-state" "DIRTY"] [?t "mergeable" "CONFLICTING"]]
[(pr-merge-state-exempt ?t) [?t "merge-state" "DRAFT"] [?t "draft" true]]
[(pr-merge-state-exempt ?t) [?t "merge-state" "UNKNOWN"] [?t "mergeable" "UNKNOWN"]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-MERGE-STATE") ?code] [?t "merge-state" ?m] (not [1 "merge-state" ?m]) [(not= ?m "BLOCKED")] [(not= ?m "BEHIND")] (not (pr-merge-state-exempt ?t)) [(str "merge state " ?m " is not current: merging is not possible yet") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-CHANGES-REQUESTED") ?code] [?t "review-decision" "CHANGES_REQUESTED"] [(str "changes requested") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-REVIEW-REQUIRED") ?code] [?t "review-decision" "REVIEW_REQUIRED"] [(str "a required approving review is missing") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-UNRESOLVED-THREADS") ?code] [?t "unresolved-threads" ?n] [(> ?n 0)] [(str ?n " unresolved review thread(s)") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-CODEX-FINDINGS") ?code] (not (declared-review-coverage ?t)) (not [?t "policy-effective" "unknown"]) [?t "codex-findings" true] [(str "Codex reports unresolved findings on the current head") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-CODEX-STALE") ?code] (not (optional-review-detail ?t)) [?t "codex-stale" true] [(str "Codex's latest review is for an older commit; current head not yet covered") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-PROVIDER-FINDINGS") ?code] (declared-review-coverage ?t) [?t "provider-finding" ?f] [?f "provider-label" ?label] [?f "finding-source" ?src] [(str ?label " reports unresolved findings on the current head " ?src) ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-PROVIDER-FINDINGS") ?code] [?t "policy-effective" "unknown"] [?t "provider-finding" ?f] [?f "provider-label" ?label] [?f "finding-source" ?src] [(str ?label " reports unresolved findings on the current head " ?src) ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-POLICY-UNSATISFIED") ?code] (declared-review-coverage ?t) [?t "policy-head-reviewed" false] [?t "policy-has-findings" false] [?t "policy-effective" ?eff] [?t "policy-summary" ?sum] [(str "review policy " ?eff ": no configured provider has accepted the current head yet (" ?sum ")") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-POLICY-UNKNOWN") ?code] [?t "policy-effective" "unknown"] [?t "policy-unknown-reason" ?why] [(str "review policy unknown (" ?why "): review coverage cannot be established") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-REVIEW-REQUEST-NONE") ?code] (not (optional-review-detail ?t)) [?t "review-request-status" "no reaction yet"] [(str "a review was requested and has had no reaction") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-REVIEW-REQUEST-PENDING") ?code] (not (optional-review-detail ?t)) [?t "review-request-status" ?st] [(not= ?st "no reaction yet")] [(not= ?st "covered")] [(str "waiting for the requested review to finish (" ?st ")") ?reason]]
[(pr-specific-blocker ?t ?code ?reason) [(str "PR-CODEX-RUNNING") ?code] (not (optional-review-detail ?t)) (not [?t "review-request-status" _]) [?t "codex-running" ?st] [(str "waiting for Codex's review of the current head to finish (" ?st ")") ?reason]]
[(has-pr-specific-blocker ?t) (pr-specific-blocker ?t ?c ?r)]
[(pr-blocker ?t ?code ?reason) [?t "closed-label" ?l] (not [?t "state" "OPEN"]) [(str "PR-CLOSED") ?code] [(str "pull request is " ?l) ?reason]]
[(pr-blocker ?t ?code ?reason) [?t "state" "OPEN"] (pr-specific-blocker ?t ?code ?reason)]
[(pr-blocker ?t ?code ?reason) [?t "state" "OPEN"] [?t "merge-state" "BLOCKED"] (not (has-pr-specific-blocker ?t)) [(str "PR-BLOCKED") ?code] [(str "GitHub reports merging is blocked (branch protection); inspect the rules") ?reason]]
]
