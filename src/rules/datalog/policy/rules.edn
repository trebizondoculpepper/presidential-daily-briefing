;; Derived predicates for the next-action policy (DataScript Datalog, not Prolog).
;; Absence is usable only after the corresponding complete relation.
;; Attributes are strings, never keywords: keyword attributes from JavaScript fail at query time.
;; Entity 1 holds the viewer and constant sets; see schema.edn.
[
[(issue ?t) [?t "kind" "issue"]]
[(pr ?t) [?t "kind" "pr"]]
[(open ?t) [?t "state" "OPEN"]]
[(claimed ?t) [?t "owner" ?a]]
[(mine ?t) [1 "agent" ?a] [?t "owner" ?a]]
[(mine-linked ?t) (mine ?t)]
[(mine-linked ?t) [1 "agent" ?a] [?t "responsible" ?a]]
[(mine-linked ?t) [?t "closes" ?i] (mine ?i)]
[(addressed ?t) [1 "agent" ?a] [?t "attention" ?a]]
;; #1018 (doc/design/human-responsibility-release.md): an explicit human-directed release of a
;; selected agent's ticket responsibility. The host asserts one release record per direction with
;; its trust level, the released agent, optional claim-start/responsibility revisions and the
;; preserved open PRs; only a trusted record is a human direction. Facts represent explicit
;; direction separately from agent/client strings; an arbitrary flag or shared login is never it.
;; Absent or unknown trust is not a trusted direction: the ordinary open-PR deny stays in force.
[(human-release ?t ?r) [?t "release" ?r] [?r "release-trust" "trusted"]]
;; An unread delivery responsibility is never "nobody": confirmed-unknown responsibility keeps the
;; work out of adoption until it is read (reviewed #1109 finding).
[(released-unowned ?t) (human-release ?t ?r) (not (claimed ?t)) (not [?t "responsible" _]) (not [?t "responsibility-unknown" true])]
;; The preserved PR itself must be unowned: a PR another agent still owns is not admissible work
;; (reviewed #1109 finding); a genuinely unowned preserved PR still qualifies.
[(preserved-pr ?t) (human-release ?t ?r) [?t "release" ?r] [?r "release-pr" ?p] [?p "state" "OPEN"] (not [?p "responsible" _]) (not [?p "responsibility-unknown" true])]
;; An otherwise-eligible agent may continue existing unowned work with a preserved open PR after
;; a human-directed release: ordinary new-implementation admission must not duplicate an open PR
;; (D-DENY-OPEN-PR stays for ordinary work), but preserved unowned work is the explicit exception.
;; Clearing ownership does not exclude the former owner (owner correction, #1130): release/removal
;; alone creates no cooldown or fresh-direction requirement for the former owner to claim or adopt.
[(adoptable ?t) (issue ?t) (open ?t) (released-unowned ?t) (preserved-pr ?t)]
[(parked ?t) [?t "label" "status:parked"]]
[(foreground ?t) (open ?t) (not (parked ?t))]
;; Repository-level recovery is context, never a fabricated owned issue.
[(foreground ?t) [?t "ownership-inventory" true]]
[(foreground ?t) (open ?t) (addressed ?t)]
;; #1021: a force request is always answered, even for a closed subject (refused as closed).
[(foreground ?t) [?t "force-request" true]]
;; Human input is waiting whatever the ticket's parking: the human view sees parked work (#457).
[(foreground ?t) (open ?t) [1 "role" "human"]]
;; #413: a claim the live read found released since the snapshot is no longer the viewer's.
[(own-issue ?t) (issue ?t) (open ?t) (mine ?t) (not [?t "claim-activity" "not-owned"])]
;; #413: a retained claim with no activity record is active (legacy claims count as active);
;; waiting, resume-required and unknown claims are not continued as implementation.
[(own-active ?t) (own-issue ?t) (not [?t "claim-activity" _])]
[(own-active ?t) (own-issue ?t) [?t "claim-activity" "active"]]
;; #652: an owned active claim held back by an open native blocker or a prerequisite label (an
;; outstanding question or design need) is managed, never continued as implementation.
[(own-held-back ?t) (own-active ?t) (blocked ?t)]
[(own-held-back ?t) (own-active ?t) (prerequisite ?t)]
[(own-continuable ?t) (own-active ?t) (not (blocked ?t)) (not (prerequisite ?t)) (not (refinement-hold ?t))]
;; A closed source stays in the human view while a trusted question on it is unsettled (#414).
[(foreground ?t) [1 "role" "human"] (orphan-source ?t)]
[(platform-ok ?t) [?t "labels-complete" true] (not [?t "platform" _])]
[(platform-ok ?t) [1 "platform" ?p] [?t "platform" ?p]]
[(platform-unknown ?t) [?t "platform" _] [1 "platform" ""]]
[(available ?t) [?t "label" "status:ready"]]
[(available ?t) [?t "label" "status:incomplete"]]
[(prerequisite ?t) [?t "label" ?l] [1 "prerequisite" ?l]]
[(has-closing ?t) [?t "closing" ?p]]
[(has-closing ?t) [?p "closes" ?t] (open ?p)]
[(closing-complete ?t) [?t "reverse-complete" true]]
[(closing-complete ?t) [?t "kind" _] [1 "forward-complete" true]]
[(otherwise ?t) (issue ?t) (open ?t) (available ?t) [?t "labels-complete" true] (platform-ok ?t) (closing-complete ?t) (not (claimed ?t)) (not (has-closing ?t)) (not (prerequisite ?t)) (not (refinement-hold ?t))]
[(blocked ?t) [?t "open-blockers" ?n] [(> ?n 0)]]
[(blocked ?t) [?t "blocker" ?i] [?i "state" "OPEN"]]
[(implementation-permit ?t) (issue ?t) (open ?t) (available ?t)]
[(implementation-permit ?t) (adoptable ?t)]
[(implementation-deny ?t ?r) (issue ?t) (claimed ?t) [(str "D-DENY-CLAIM") ?r]]
[(implementation-deny ?t ?r) (issue ?t) (prerequisite ?t) [(str "D-DENY-PREREQUISITE") ?r]]
[(implementation-deny ?t ?r) (issue ?t) (has-closing ?t) (not (adoptable ?t)) [(str "D-DENY-OPEN-PR") ?r]]
[(implementation-deny ?t ?r) (issue ?t) (blocked ?t) [(str "D-DENY-BLOCKER") ?r]]
[(implementation-deny ?t ?r) (issue ?t) [?t "labels-complete" false] [(str "D-DENY-LABELS-UNKNOWN") ?r]]
[(implementation-deny ?t ?r) (issue ?t) [?t "native-complete" false] [(str "D-DENY-NATIVE-UNKNOWN") ?r]]
[(implementation-deny ?t ?r) (issue ?t) (not (closing-complete ?t)) [(str "D-DENY-CLOSING-UNKNOWN") ?r]]
[(implementation-deny ?t ?r) (issue ?t) (not (platform-ok ?t)) [(str "D-DENY-PLATFORM") ?r]]
;; #413: an incomplete inventory cannot rule out omitted active claims, even if every
;; observed claim is waiting; new pickup is denied rather than inviting a claim that the guard may refuse.
;; #1018: the inventory safeguard also covers adoptable existing work — an omitted active claim
;; cannot be ruled out there either, so a preserved-PR adoption must not bypass it.
;; The adoptable constituents are inlined (not the adoptable predicate) because a fluent predicate
;; with a `not` inside its body fails DataScript's join check when called from another rule body.
[(implementation-deny ?t ?r) (issue ?t) (open ?t) (available ?t) (not (claimed ?t)) [1 "owned-claims-complete" false] [(str "D-DENY-INVENTORY-UNKNOWN") ?r]]
[(implementation-deny ?t ?r) (issue ?t) (open ?t) [?t "release" ?rel] [?rel "release-trust" "trusted"] [?rel "release-pr" ?p] [?p "state" "OPEN"] (not (claimed ?t)) (not [?t "responsible" _]) [1 "owned-claims-complete" false] [(str "D-DENY-INVENTORY-UNKNOWN") ?r]]
;; #1092 (doc/design/estimation-refinement-loop.md): needs refinement denies pickup whatever the
;; estimate or readiness label says; an unknown refinement state or incomplete refinement
;; evidence fails closed. Resolving it returns the item for estimation, never to readiness.
[(implementation-deny ?t ?r) (needs-refinement ?t) (issue ?t) [(str "D-DENY-REFINEMENT") ?r]]
[(implementation-deny ?t ?r) (awaiting-reestimate ?t) (issue ?t) [(str "D-DENY-REESTIMATE") ?r]]
[(implementation-deny ?t ?r) [?t "refinement-complete" false] (issue ?t) [(str "D-DENY-REFINEMENT-UNKNOWN") ?r]]
[(held ?t) [?t "label" "status:blocked"]]
[(held ?t) [?t "label" "status:parked"]]
[(claim-deny ?t ?code) (implementation-deny ?t ?code)]
[(claim-deny ?t ?code) (issue ?t) (open ?t) (not (claimed ?t)) [1 "owned-claims-complete" false] [(str "CLAIM-INVENTORY-UNKNOWN") ?code]]
;; #1018: adoptable preserved unowned work may retain status:awaiting-review; the claim needed to
;; become responsible must not be refused for missing status:ready/incomplete. Readiness still
;; gates ordinary pickups; adoption is the documented exception.
[(claim-deny ?t ?code) (issue ?t) (not (available ?t)) (not (adoptable ?t)) [(str "CLAIM-NOT-READY") ?code]]
[(implementation-denied ?t) (implementation-deny ?t ?r)]
;; #1021 (doc/design/human-force-overrides.md): an explicit human-directed workflow override. The
;; host asserts the request, operation, reason validity, revision freshness and whether the agent
;; is known; human direction is asserted by the trusted local CLI, never inferred from a client or
;; agent name. Native admission stays the decision source: force lists every claim denial and
;; overrides only workflow-policy ones. Missing evidence, another owner's claim and an incomplete
;; inventory are technical or authority facts that force cannot invent or displace. The reason's
;; content is never graded. Supported operations are claim, resume and rework (shared admission);
;; other operations are refused here until their own native decision and execution path exist.
[(force-supported ?t) [?t "force-operation" "claim"]]
[(force-supported ?t) [?t "force-operation" "resume"]]
[(force-supported ?t) [?t "force-operation" "rework"]]
;; Resume and rework continue the caller's own retained claim (#1197 review): there the claim
;; denial is the precondition, not a denial. Any other owner's claim stays non-overridable.
[(force-continuation ?t) [?t "force-operation" "resume"]]
[(force-continuation ?t) [?t "force-operation" "rework"]]
[(force-other-owner ?t) [?t "owner" ?o] [1 "agent" ?a] [(not= ?o ?a)]]
;; A claim the live read found released since the snapshot is not retained (#413, #1197 review).
;; A claim of a ticket the caller already holds exclusively is the idempotent no-op/repair path
;; of planClaim (claims.ts), not another owner's claim (#1197 review).
[(force-own-continuation ?t) [?t "force-operation" "claim"] [1 "agent" ?a] [?t "owner" ?a] (not (force-other-owner ?t)) (not [?t "claim-activity" "not-owned"])]
[(force-own-continuation ?t) [?t "force-operation" "resume"] [1 "agent" ?a] [?t "owner" ?a] (not (force-other-owner ?t)) (not [?t "claim-activity" "not-owned"])]
;; Rework reacquires submitted work through ticket responsibility (doc/design/delivery-lifecycle.md
;; "Rework authority", #1197 review): the caller is responsible, the claim may already be released,
;; and no other agent owns it. A caller still holding the claim reworks it too.
[(force-own-continuation ?t) [?t "force-operation" "rework"] [1 "agent" ?a] [?t "responsible" ?a] (not (force-other-owner ?t))]
;; Legacy rework authority (deliverables.ts reworkAuthority: the caller's trusted v1 done handoff),
;; asserted by the host as evidence; it admits rework without being delivery responsibility.
[(force-own-continuation ?t) [?t "force-operation" "rework"] [1 "agent" ?a] [?t "legacy-rework-agent" ?a] (not (force-other-owner ?t))]
[(force-own-continuation ?t) [?t "force-operation" "rework"] [1 "agent" ?a] [?t "owner" ?a] (not (force-other-owner ?t)) (not [?t "claim-activity" "not-owned"])]
;; Which pickup denials each operation actually applies (#1197 reviews), mirroring normal admission:
;; claim applies them all; rework (claims.ts) skips readiness and its own open PR; resume
;; (retained.ts planClaimResume) checks only native blockers and their evidence among them.
;; An already-held exclusive claim returns planClaim's no-op/repair before any acquisition check.
;; An already-held exclusive claim (claim or rework retry) and an already-active resume take their
;; normal no-op paths before any acquisition or blocker check (claims.ts planClaimFor, retained.ts
;; planClaimResume; #1197 reviews).
[(force-owned-retry ?t) [?t "force-operation" "claim"] [1 "agent" ?a] [?t "owner" ?a] (not (force-other-owner ?t)) (not [?t "claim-activity" "not-owned"])]
[(force-owned-retry ?t) [?t "force-operation" "rework"] [1 "agent" ?a] [?t "owner" ?a] (not (force-other-owner ?t)) (not [?t "claim-activity" "not-owned"])]
[(force-already-active ?t) [?t "force-operation" "resume"] (force-own-continuation ?t) (not [?t "claim-activity" _])]
[(force-already-active ?t) [?t "force-operation" "resume"] (force-own-continuation ?t) [?t "claim-activity" "active"]]
[(force-denial ?t ?r) [?t "force-operation" "claim"] (not (force-owned-retry ?t)) (claim-deny ?t ?r) [(not= ?r "D-DENY-CLAIM")]]
;; ...except incomplete labels, which planClaim refuses first: they cannot rule out another owner.
[(force-denial ?t ?r) (force-owned-retry ?t) (claim-deny ?t ?r) [(= ?r "D-DENY-LABELS-UNKNOWN")]]
[(force-denial ?t ?r) [?t "force-operation" "rework"] (not (force-owned-retry ?t)) (claim-deny ?t ?r) [(not= ?r "D-DENY-CLAIM")] [(not= ?r "CLAIM-NOT-READY")] [(not= ?r "D-DENY-OPEN-PR")]]
[(force-denial ?t ?r) [?t "force-operation" "resume"] (not (force-already-active ?t)) (claim-deny ?t ?r) [(= ?r "D-DENY-BLOCKER")]]
[(force-denial ?t ?r) [?t "force-operation" "resume"] (not (force-already-active ?t)) (claim-deny ?t ?r) [(= ?r "D-DENY-NATIVE-UNKNOWN")]]
[(force-denial ?t ?r) (claim-deny ?t ?r) [(= ?r "D-DENY-CLAIM")] (not (force-own-continuation ?t))]
;; A continuation of the caller's claim is still checked against an incomplete claim inventory
;; (#1197 review): the unclaimed-pickup inventory denials do not cover a claimed ticket, so the
;; continuation derives it here and force cannot authorize resuming against unknown ownership.
;; An absent inventory fact is "not read", never complete (#1197 review): only an explicit true passes.
[(force-inventory-read ?t) [?t "kind" _] [1 "owned-claims-complete" true]]
;; Every forced operation needs an explicitly complete claim inventory (#1197 review).
[(force-denial ?t ?r) [?t "force-request" true] (not (force-already-active ?t)) (not (force-inventory-read ?t)) [(str "CLAIM-INVENTORY-UNKNOWN") ?r]]
;; Normal admission refuses while the caller holds other active claims (claims.ts/retained.ts
;; admissionFor, #1197 review): known active work is a workflow denial a human may override;
;; another claim whose activity is unknown is missing evidence.
[(force-denial ?t ?r) [?t "force-request" true] (not (force-already-active ?t)) (own-issue ?o) [(not= ?t ?o)] (not [?o "claim-activity" _]) [(str "FORCE-OTHER-ACTIVE-CLAIM") ?r]]
[(force-denial ?t ?r) [?t "force-request" true] (not (force-already-active ?t)) (own-issue ?o) [(not= ?t ?o)] [?o "claim-activity" "active"] [(str "FORCE-OTHER-ACTIVE-CLAIM") ?r]]
[(force-denial ?t ?r) [?t "force-request" true] (not (force-already-active ?t)) (own-issue ?o) [(not= ?t ?o)] [?o "claim-activity" "resume-required"] [(str "FORCE-OTHER-ACTIVE-CLAIM") ?r]]
;; Resuming past a still-open wait (retained.ts BLOCKER_OPEN, D-OWN-WAIT) is a workflow override.
[(force-denial ?t ?r) [?t "force-operation" "resume"] [?t "claim-activity" "waiting"] [(str "FORCE-WAIT-OPEN") ?r]]
;; Every trusted v2 question still unresolved on the claim blocks resume (retained.ts QUESTION_OPEN),
;; independently of routing labels or the bound wait (#1197 review).
[(force-denial ?t ?r) [?t "force-operation" "resume"] (not (force-already-active ?t)) [?t "question-record" ?q] [?q "record-trust" "trusted"] [?q "record-version" 2] [?q "record-outcome" "none"] [(str "FORCE-QUESTION-OPEN") ?r]]
;; A closed ticket is never claimed or resumed (claims.ts TICKET_CLOSED); force cannot reopen it.
[(force-denial ?t ?r) [?t "force-request" true] [?t "state" ?st] [(not= ?st "OPEN")] [(str "FORCE-TICKET-CLOSED") ?r]]
;; Unverifiable v2 question authority or resolution is missing evidence (retained.ts EVIDENCE_INCOMPLETE);
;; legacy v1 questions keep label-based resolution and are skipped, as resume skips them.
[(force-denial ?t ?r) [?t "force-operation" "resume"] (not (force-already-active ?t)) [?t "question-record" ?q] [?q "record-trust" "unverified"] [?q "record-version" 2] [(str "FORCE-QUESTION-UNKNOWN") ?r]]
[(force-denial ?t ?r) [?t "force-operation" "resume"] (not (force-already-active ?t)) [?t "question-record" ?q] [?q "record-trust" "trusted"] [?q "record-version" 2] [?q "record-outcome" "unknown"] [(str "FORCE-QUESTION-UNKNOWN") ?r]]
[(force-denial ?t ?r) [?t "force-request" true] (not (force-already-active ?t)) (own-issue ?o) [(not= ?t ?o)] [?o "claim-activity" "unknown"] [(str "FORCE-OTHER-ACTIVITY-UNKNOWN") ?r]]
;; Unknown refinement evidence is technical, even where a known refinement hold is a workflow denial.
[(force-denial ?t ?r) (issue ?t) [?t "force-operation" ?op] [(not= ?op "resume")] (refinement-unknown ?t) [(str "D-DENY-REFINEMENT-UNKNOWN") ?r]]
;; Resume and rework continue only the caller's own retained claim; without it there is nothing to
;; continue, and force cannot make the caller the owner.
[(force-denial ?t ?r) [?t "force-operation" "resume"] (not (force-own-continuation ?t)) [(str "FORCE-NOT-RETAINED") ?r]]
;; Unknown retained activity is missing evidence (retained.ts EVIDENCE_INCOMPLETE, #1197 review).
[(force-denial ?t ?r) [?t "force-operation" "resume"] [?t "claim-activity" "unknown"] [(str "FORCE-ACTIVITY-UNKNOWN") ?r]]
[(force-denial ?t ?r) [?t "force-operation" "rework"] (not (force-own-continuation ?t)) [(str "FORCE-NOT-RESPONSIBLE") ?r]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "D-DENY-CLAIM")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "D-DENY-LABELS-UNKNOWN")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "D-DENY-NATIVE-UNKNOWN")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "D-DENY-CLOSING-UNKNOWN")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "D-DENY-INVENTORY-UNKNOWN")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "D-DENY-REFINEMENT-UNKNOWN")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "CLAIM-INVENTORY-UNKNOWN")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "FORCE-NOT-RETAINED")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "FORCE-NOT-RESPONSIBLE")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "FORCE-ACTIVITY-UNKNOWN")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "FORCE-OTHER-ACTIVITY-UNKNOWN")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "FORCE-TICKET-CLOSED")]]
[(force-technical ?t) (force-denial ?t ?r) [(= ?r "FORCE-QUESTION-UNKNOWN")]]
[(force-denied ?t) (force-denial ?t ?r)]
;; Every precondition of an admissible request, in one place so each outcome is exclusive.
[(force-ready ?t) [?t "force-request" true] (force-supported ?t) [?t "force-reason" "valid"] [?t "force-agent" "known"] [?t "force-revision" "current"]]
[(eligible ?t) (implementation-permit ?t) (not (adoptable ?t)) (not (implementation-denied ?t))]
[(design-eligible ?t) (issue ?t) (open ?t) [?t "label" "status:needs-design"] [?t "labels-complete" true] (platform-ok ?t) (closing-complete ?t) (not (claimed ?t)) (not (has-closing ?t)) (not [?t "label" "design:decision-needed"])]
[(possible ?t) (available ?t) (not (claimed ?t)) (not (prerequisite ?t)) (not (blocked ?t)) (not (has-closing ?t))]
[(possible ?t) [?t "label" "status:needs-design"] (not (claimed ?t)) (not (has-closing ?t))]
[(uncertain ?t) [?t "labels-complete" false]]
[(uncertain ?t) [?t "native-complete" false]]
[(uncertain ?t) [?t "kind" _] (not (closing-complete ?t))]
[(uncertain ?t) (platform-unknown ?t)]
[(large-impact ?t) [?t "impact-state" "current"] [?t "impact-size" ?s] [1 "large" ?s]]
[(small-complexity ?t) [?t "complexity-state" "current"] [?t "complexity-size" ?s] [1 "small" ?s]]
[(easy ?t) (large-impact ?t) (small-complexity ?t)]
[(unfavorable ?t) [?t "impact-state" "current"] [?t "impact-size" ?i] [1 "small" ?i] [?t "complexity-state" "current"] [?t "complexity-size" ?c] [1 "large" ?c]]
;; #1092: an open refinement is answered first; resolution then returns it for estimation.
[(needs-complexity ?t) [?t "complexity-state" ?s] [1 "needs-assessment" ?s] (not (needs-refinement ?t))]
[(needs-impact ?t) [?t "impact-state" ?s] [1 "needs-assessment" ?s]]
[(bad-complexity ?t) [?t "complexity-state" ?s] [1 "bad-assessment" ?s]]
[(bad-impact ?t) [?t "impact-state" ?s] [1 "bad-assessment" ?s]]
[(design-pr ?t) (pr ?t) [?t "label" ?l] [1 "design-label" ?l]]
[(design-pr ?t) (pr ?t) [?t "closes" ?i] [?i "label" ?l] [1 "design-label" ?l]]
[(pr-failure ?t) [?t "check" ?c] [?c "outcome" ?o] [1 "failure" ?o]]
[(pr-pending ?t) [?t "check" ?c] [?c "outcome" ?o] [1 "pending" ?o] (not [?c "required" "advisory"])]
[(pr-pending ?t) [?t "missing-required" ?m]]
[(pr-unknown ?t) [?t "check" ?c] [?c "outcome" ?o] (not [1 "known-check" ?o])]
[(pr-review ?t) [?t "review-decision" "CHANGES_REQUESTED"]]
[(pr-review ?t) [?t "thread" ?c] [?c "resolved" false]]
[(pr-review ?t) (head-findings ?t)]
;; Required-check readiness is target evidence, never a universal check name (#676).
[(required-unsatisfied ?t) [?t "check" ?c] [?c "required" "required"] [?c "outcome" ?o] [(not= ?o "SUCCESS")]]
[(required-unknown ?t) [?t "check" ?c] [?c "required" "unknown"]]
[(requirements-satisfied ?t) [?t "required-evidence-complete" true] (not (required-unsatisfied ?t)) (not (required-unknown ?t)) (not [?t "missing-required" _])]
;; The engine materializes the native check-ready query once; hosts cannot supply this fact.
[(verified ?t) [?t "native-checks-satisfied" true]]
[(check-blocker ?t ?code ?reason) [(str "RC-COVERAGE") ?code] [?t "required-evidence-complete" false] (not [?t "required-evidence-gap" _]) [(str "Required-check evidence incomplete") ?reason]]
[(check-blocker ?t ?code ?reason) [(str "RC-REQUIREDNESS") ?code] [?t "check" ?c] [?c "required" "unknown"] [?c "name" ?name] [(str "Requiredness unknown: " ?name) ?reason]]
[(check-blocker ?t ?code ?reason) [(str "RC-GAP") ?code] [?t "required-evidence-gap" ?gap] [(str "Required-check evidence unknown: " ?gap) ?reason]]
[(check-blocker ?t ?code ?reason) [(str "RC-MISSING") ?code] [?t "missing-required" ?name] [(str "Required check not yet reported: " ?name) ?reason]]
[(check-blocker ?t ?code ?reason) [(str "RC-OUTCOME") ?code] [?t "check" ?c] [?c "required" "required"] [?c "name" ?name] [?c "outcome" ?o] [(not= ?o "SUCCESS")] [(str "Required check " ?name " is " ?o) ?reason]]
[(clean-pr ?t) (pr ?t) [?t "pr-complete" true] [?t "draft" false] [?t "mergeable" "MERGEABLE"] [?t "merge-state" ?m] [1 "merge-state" ?m] (verified ?t) (not (pr-failure ?t)) (not (pr-pending ?t)) (not (pr-unknown ?t)) (not (pr-review ?t))]
;; Review coverage (#301): legacy unless the repository declared a registered policy. Absent
;; review-coverage is legacy; `unknown` accepts nothing. Provider facts are host-normalized:
;; authenticated integration, bound to the full head, one state per provider.
[(legacy-coverage ?t) [?t "head" _] (not-join [?t] [1 "review-coverage" "any"]) (not-join [?t] [1 "review-coverage" "unknown"])]
[(head-reviewed ?t) (legacy-coverage ?t) [?t "head" ?h] [?t "review" ?r] [?r "review-state" "APPROVED"] [?r "review-commit" ?h]]
[(head-reviewed ?t) (legacy-coverage ?t) [?t "head" ?h] [?t "receipt" ?c] [?c "receipt-commit" ?h] [?c "receipt-status" "completed"] [?c "receipt-findings" false]]
