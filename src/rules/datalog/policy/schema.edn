;; Database schema, constant sets (asserted on entity 1) and the witnesses every explanation may use.
;; Each witness is a vector of where-clauses binding ?value for subject ?t.
{:policy-version 1
 :many
 ["required-evidence-gap" "missing-required" "label" "owner" "responsible" "platform" "attention" "blocker" "dependent" "closes" "closing" "check" "review" "receipt" "provider-review" "provider-finding" "thread" "matched" "overridden" "unlocks-dependent" "permit" "deny" "unknown" "unlock-unknown" "question-record"]
 :constants
 {"small" ["XS" "S"]
  "large" ["L" "XL" "XXL"]
  "needs-assessment" ["unassessed" "stale"]
  "bad-assessment" ["invalid" "conflict"]
  "prerequisite" ["status:needs-design" "question" "design:decision-needed" "status:blocked" "status:parked"]
  "design-label" ["documentation" "status:needs-design"]
  "failure" ["FAILURE" "ERROR" "TIMED_OUT" "CANCELLED" "ACTION_REQUIRED" "STARTUP_FAILURE" "STALE"]
  "pending" ["PENDING" "QUEUED" "IN_PROGRESS" "WAITING" "REQUESTED" "EXPECTED"]
  "known-check" ["SUCCESS" "NEUTRAL" "SKIPPED" "FAILURE" "ERROR" "TIMED_OUT" "CANCELLED" "ACTION_REQUIRED" "STARTUP_FAILURE" "STALE" "PENDING" "QUEUED" "IN_PROGRESS" "WAITING" "REQUESTED" "EXPECTED"]
  "merge-state" ["CLEAN" "HAS_HOOKS" "UNSTABLE"]
  "refresh-state" ["BEHIND" "UNKNOWN"]
  "unknown-mergeable" ["UNKNOWN"]
  "readiness" ["status:ready" "status:incomplete"]
  "question-label" ["question" "design:decision-needed"]}
 :common-witnesses
 {"impact" [[?t "impact-size" ?value]]
  "complexity" [[?t "complexity-size" ?value]]
  "impactState" [[?t "impact-state" ?value]]
  "complexityState" [[?t "complexity-state" ?value]]
  "head" [[?t "head" ?value]]
  "responsible" [[?t "responsible" ?value]]}
 :eligibility-witnesses
 {"labelsComplete" [[?t "labels-complete" ?value]]
  "nativeComplete" [[?t "native-complete" ?value]]
  "openBlockers" [[?t "open-blockers" ?value]]
  "readiness" [[?t "label" ?value] [1 "readiness" ?value]]}
 :lexicon
 ;; Phrases naming the inputs the rules read, for `pdb rules` (#416). A phrase names an input
 ;; only and never describes a rule. The build fails if a literal attribute in any rule, query
 ;; or witness lacks a phrase here, or if an entry here is unused. Constant sets need none.
 ;; :viewer names the viewer facts the engine asserts on entity 1.
 {:attributes
  {"ownership-inventory" "repository ownership inventory context"
   "claim-activity" "activity of your retained claim (active, waiting, resume-required or unknown)"
   "wait-reason" "what your retained claim waits on, or why its activity is unknown"
   "owned-claims" "number of implementation claims you retain"
   "owned-claims-complete" "completeness of your claim inventory"
