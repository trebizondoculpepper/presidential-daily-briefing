{
  "name": "@trebizondoculpepper/presidential-daily-briefing",
  "version": "0.1.0",
  "description": "Presidential Daily Briefing: evidence-linked GitHub work queues for coding agents",
  "bugs": {
    "url": "https://github.com/trebizondoculpepper/presidential-daily-briefing/issues"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trebizondoculpepper/presidential-daily-briefing.git"
  },
  "bin": {
    "github-triage": "dist/cli.mjs",
    "github-triage-mcp": "dist/mcp.mjs",
    "pdb": "dist/cli.mjs",
    "pdb-mcp": "dist/mcp.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "dist/cli.mjs.map",
    "dist/mcp.mjs",
    "dist/mcp.mjs.map",
    "third-party",
    "dist/datalog-*.mjs",
    "dist/datalog-*.mjs.map",
    "dist/engine-*.mjs",
    "dist/engine-*.mjs.map",
    "dist/requiredchecks-*.mjs",
    "dist/requiredchecks-*.mjs.map",
    "dist/english-render-*.mjs",
    "dist/english-render-*.mjs.map",
    "dist/web/rules.js",
    "dist/web/rules.css",
    "dist/web/discussion.css",
    "dist/web/discussion.js",
    "dist/web/pipeline.js",
    "dist/web/pipeline.css",
    "dist/web/work.js",
    "dist/web/work.css",
    "dist/web/timing.js",
    "dist/web/timing.css",
    "dist/web/overview.js",
    "dist/web/overview.css"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "triage": "tsx src/cli.ts",
    "build": "vp pack src/cli.ts --format esm --out-dir dist --sourcemap && vp pack src/mcp.ts --format esm --out-dir dist --no-clean --sourcemap && tsx scripts/sourcemaps.ts dist && npm run build:web",
    "build:web": "tsx scripts/build-web.ts",
    "check": "vp check && tsc -p doc/reports/examples && tsx src/rules/datalog/build.ts --check && tsx scripts/check-svelte.ts",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test run",
    "postinstall": "node -e \"console.log('Run pdb onboard in your project for onboarding instructions.')\"",
    "prepare": "vp config --hooks --no-agent",
    "smoke": "tsx scripts/smoke.ts dist/cli.mjs",
    "prepack": "npm run build",
    "package-test": "tsx scripts/package-test.ts",
    "release": "tsx scripts/release.ts",
    "make-prerelease": "tsx scripts/make-prerelease.ts",
    "mcp": "tsx src/mcp.ts",
    "pdb": "tsx src/cli.ts",
    "rules:build": "tsx src/rules/datalog/build.ts",
    "rules:test": "tsx src/rules/datalog/runner.ts",
    "test:report": "tsx scripts/test-report.ts",
    "website:preview:build": "tsx scripts/website/build.ts --preview",
    "website:capture": "tsx scripts/website/run-capture.ts",
    "test:manual:formal": "vp test run --config vite.manual.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@sentry/node": "11.12.0",
    "datascript": "1.8.1",
    "edn-data": "1.2.2",
    "env-paths": "4.0.0",
    "smol-toml": "1.9.1",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "5.58.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "engines": {
    "node": ">=26"
  }
}
